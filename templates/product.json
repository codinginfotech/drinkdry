    "custom_collapsible_content_cKVyMJ": {
      "type": "custom_collapsible-content",
      "blocks": {
        "collapsible_row_njAceH": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I place an order?",
            "row_content": "<ol><li>Browse our selection and add your favorite products to the cart.</li><li>When you’re ready, go to your cart and click <a href=\"/checkout\" title=\"/checkout\">Checkout</a>.</li><li>Enter your shipping details and choose your preferred payment method.</li><li>Confirm your order, and you’ll receive an email confirmation right away.</li></ol>",
            "page": "",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "collapsible_row_9KfthT": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if my order is missing?",
            "row_content": "<p>If you think that we got your order wrong, please reach out to us through one of our customer support channels, and our team will be happy to support you in tracking down your order. Please ensure you have your order number at hand: </p><ul><li><strong>Facebook</strong>: <a href=\"https://www.facebook.com/drinkdry\">https://www.facebook.com/drinkdry</a></li><li><strong>Instagram</strong>: <a href=\"https://www.instagram.com/drinkdrystore/\">https://www.instagram.com/drinkdrystore</a></li><li><strong>Email</strong>: <a href=\"https://drinkdrystore.com/#SALES@DRINKDRYSTORE.COM\">sales@drinkdrystore.com</a></li><li><strong>Whatsapp</strong>: +971 50 705 5461 </li></ul>",
            "page": "",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "collapsible_row_ycwJVq": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if my order is incomplete?",
            "row_content": "<p>Please note that we only charge you for items that we deliver to you. We are sorry for any inconvenience caused by incomplete orders.  Please reach out to us through one of our customer support channels, and we will look into this matter and resolve it ASAP. Please ensure you have your order number at hand: </p><ul><li><strong>Facebook</strong>: <a href=\"https://www.facebook.com/drinkdry\">https://www.facebook.com/drinkdry</a></li><li><strong>Instagram</strong>: <a href=\"http://www.instagram.com/drinkdrystore/\">instagram.com/drinkdrystore/</a></li><li><strong>Email</strong>: <a href=\"https://drinkdrystore.com/#SALES@DRINKDRYSTORE.COM\">sales@drinkdrystore.com</a></li><li><strong>Whatsapp</strong>: +971 50 705 5461  </li></ul>",
            "page": "",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "collapsible_row_83BpeR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "If I change my mind, how can I change/cancel my order?",
            "row_content": "<p>We are sorry to hear that you want to cancel your order. The quickest way to do that is to contact our customer support team via one of the below channels: </p><ul><li><strong>Facebook</strong>: <a href=\"https://www.facebook.com/drinkdry\">https://www.facebook.com/drinkdry</a></li><li><strong>Instagram</strong>: <a href=\"http://www.instagram.com/drinkdrystore/\">instagram.com/drinkdrystore/</a></li><li><strong>Email</strong>: <a href=\"https://drinkdrystore.com/#SALES@DRINKDRYSTORE.COM\">sales@drinkdrystore.com</a></li><li><strong>Whatsapp</strong>: +971 50 705 5461 </li></ul><p>If you have made the purchase online with a credit card, payment will be reversed in 3-5 business days.  </p>",
            "page": "",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        }
      },

            "highlight_style": "marker"
          }
        },
        "question_dfykdn": {
          "type": "question",
          "settings": {
            "title": "Credit/Debit Cards ",
            "text": "<p>We use the most secure payment gateway to offer you a fast, safe, and secure way of paying using either MasterCard or VISA. </p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_EUEx7J": {
          "type": "question",
          "settings": {
            "title": "Cash on Delivery ",
            "text": "<p>If you choose to pay cash on delivery, please make sure you select that as an option when placing your order. Our drivers carry change. </p>",

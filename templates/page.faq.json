    "faq_Q48gPC": {
      "type": "faq",
      "blocks": {
        "question_67mTNB": {
          "type": "question",
          "settings": {
            "title": "What is the delivery time for any purchase made online?",
            "text": "<p><span style=\"text-decoration:underline\"><strong>Dubai Deliveries:</strong></span> Available daily, within Dubai city limits. Order before 4pm for Same Day Delivery. Order placed after 4pm will be delivered the next day. </p><p><span style=\"text-decoration:underline\"><strong>Abu Dhabi Deliveries:</strong></span> Now scheduled every Friday, and limited to addresses within Abu Dhabi city limits.</p><p><span style=\"text-decoration:underline\"><strong>Other Emirates:</strong></span> At this time, we are unable to deliver outside of Dubai and Abu Dhabi. We apologise for the inconvenience.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_4UddPH": {
          "type": "question",
          "settings": {
            "title": "Do you ship internationally?",
            "text": "<p>No, right now our deliveries are limited within UAE<strong>( Dubai & Abu Dhabi )</strong>only.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_wW34xV": {
          "type": "question",
          "settings": {
            "title": "How can I track my shipment?",
            "text": "<p>Currently, we do not have a live order tracking on the website. The status of your order is updated to you via SMS on a regular basis. In case you need any urgent updates on your order status,  please WhatsApp our Customer Care team.</p><ul><li><strong>Whatsapp</strong>: +971 56 415 0041 </li></ul>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_Bcwt8A": {
          "type": "question",
          "settings": {
            "title": "Is delivery free? If No, what is the minimum amount of purchase required for free of charge delivery?",
            "text": "<p>Our delivery fee is AED 25. Orders over AED 250 qualify for free shipping.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_XHJPaE": {
          "type": "question",
          "settings": {
            "title": "Is there any limit on the quantity, weight, or dimension of the product that I can purchase online?",
            "text": "<p>There are no such limits. Feel free to order as many of your favourite drinks as you wish.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_aEkgzw": {
          "type": "question",
          "settings": {
            "title": "Can I cancel the order after dispatch but before the scheduled delivery date? If so, then how will the refund be processed?",
            "text": "<p>No. Orders can only be cancelled before dispatch without any charges.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_mPAPt7": {
          "type": "question",
          "settings": {
            "title": "What if I receive an incorrect product? Can the correct product be delivered on priority?",
            "text": "<p>If an incorrect product is delivered due to the mistake of Drink Dry, it will be replaced with the correct product within a targeted time frame of 1-2 working days <strong>(subject to availability).</strong></p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_AYqicJ": {
          "type": "question",
          "settings": {
            "title": "What if I am unavailable at the time of delivery?  Can I reschedule it? Will there be any charges for the same?",
            "text": "<p>Yes, delivery can be rescheduled for the next available date. If you do not accept delivery for over 14 days, we reserve the right to cancel the invoice, and a store credit will be issued.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_K9xnRq": {
          "type": "question",
          "settings": {
            "title": "Can I nominate someone else to receive the delivery on my behalf?",
            "text": "<p>Yes, you can nominate, but we would like to have a copy of his/her ID at the time of delivery. Please contact our customer service in advance to nominate the recipient.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_VLRNFW": {
          "type": "question",
          "settings": {
            "title": "Can I change the delivery address after I have purchased the product online?",
            "text": "<p>Yes, you can change the delivery address before delivery, subject to the new location being in the same city. Please call our customer service team on +971 50 705 5461. Please note there may be some locations where we cannot make deliveries.</p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        },
        "question_T4wefy": {
          "type": "question",
          "settings": {
            "title": "Can I add more items to the existing order and include them in the same delivery?",
            "text": "<p>Existing orders cannot be amended to add new products. You can raise a new order for additional products. </p>",
            "enable_highlight": false,
            "highlight_style": "marker"
          }
        }

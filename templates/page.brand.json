          "settings": {
            "avatar": "shopify://shop_images/woman-in-sports-clothes-stands-on-a-beach-in-the-morning-light.jpg",
            "text": "<p>Corona Cero is the ultimate crowd-pleaser for sunset moments, BBQ gatherings, and beach days. Crisp and refreshing, just like the original!</p>",
            "name": "Alex P.",
            "card_bg": "#ffffff",
            "text_color": "#1a2741",
            "name_color": "#1a2741"
          }

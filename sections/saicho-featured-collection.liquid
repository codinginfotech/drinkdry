{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  {% comment %} <div class="page-width"> {% endcomment %}
    <div class="title-wrapper{% if section.settings.heading == blank %} title-wrapper--no-heading{% endif %} {{ section.settings.heading_alignment }}">
      <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">
        {%- render 'highlight-text', 
          hl_input: section.settings.heading, 
          hl_style: section.settings.highlight_style,
          hl_enable: section.settings.enable_highlight,
          hl_animateWrap: true -%}
      </{{ section.settings.heading_tag }}>
    </div>

    {%- liquid
      assign products_to_display = section.settings.collection.all_products_count

      if section.settings.collection.all_products_count > section.settings.products_to_show
        assign products_to_display = section.settings.products_to_show
      endif

      assign class_slider = 'slider'
      if section.settings.swipe_on_mobile
        assign class_slider = class_slider | append: ' slider--tablet'
      endif
      assign class_grid_2_col_tablet = 'grid--2-col-tablet'
      assign class_grid_3_col_tablet = 'grid--3-col-tablet'
      assign class_grid_3_col_desktop = 'grid--3-col-desktop'
      assign class_grid_4_col_desktop = 'grid--4-col-desktop'
      assign disable_image_click = false

      if section.settings.horizontal_scroll
        assign class_grid_2_col_tablet = 'grid--2p3-col-tablet'
        assign class_grid_3_col_tablet = 'grid--3p3-col-tablet'
        assign class_grid_3_col_desktop = 'grid--3p3-col-desktop'
        assign class_grid_4_col_desktop = 'grid--4p3-col-desktop'
        assign class_slider = class_slider | append: ' slider--tablet-up'
        if section.settings.products_to_show > 4
          assign disable_image_click = false
          assign class_slider = class_slider | append: ' cursor--drag'
        endif
      endif
    %}

    <div class="slider-mobile-gutter">
      <ul id="Slider-{{ section.id }}"
        class="product-grid grid grid--rigid{% if section.settings.columns_mobile == '1' %} grid--1-col-mobile{% endif %} grid--2-col{% if section.settings.collection == blank or products_to_display == 4 and section.settings.swipe_on_mobile == false %} {{ class_grid_2_col_tablet }} {{ class_grid_4_col_desktop }}{% else %} {{ class_grid_3_col_tablet }}{% if products_to_display == 6 %} {{ class_grid_3_col_desktop }}{% else %} {{ class_grid_4_col_desktop }}{% endif %}{% endif %}{% if section.settings.collection.all_products_count > 2 and section.settings.products_to_show > 2 %} {{ class_slider }}{% endif %}{% if section.settings.collection == blank %} {{ class_slider }}{% endif %}"
        role="list"{% if section.settings.horizontal_scroll %} is="scroll-snap-slider" data-draggable="{{ section.settings.enable_drag }}"{% endif %}
      >
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item{% if section.settings.collection.all_products_count > 2 and section.settings.swipe_on_mobile and section.settings.products_to_show > 2 %} slider__slide{% endif %}"
          >
            {% render 'card-product',
              card_product: product,
              card_collection: section.settings.collection,
              media_size: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_quick_buy: section.settings.show_quick_buy,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              enable_quick_view: section.settings.enable_quick_view,
              enable_color_swatches: section.settings.enable_color_swatches,
              enable_countdown: section.settings.enable_countdown,
              enable_image_fill: section.settings.enable_image_fill,
              disable_image_click: disable_image_click
            %}
          </li>
        {%- else -%}
          {%- for i in (1..4) -%}
            <li class="grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}">
              {% render 'card-product-placeholder', media_size: section.settings.image_ratio %}
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      {% if section.settings.horizontal_scroll %}
        <div class="slider-buttons no-js-hidden small-hide{% if section.settings.products_to_show <= 4 %} large-up-hide{% if section.settings.products_to_show <= 3 %} medium-hide{% endif %}{% endif %}{% if section.settings.show_arrows_desktop == false %} large-up-hide{% endif %}{% if section.settings.show_arrows_mobile == false %} small-hide{% endif %}">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" disabled="disabled">
            {% render 'icon', icon: 'chevron' %}
          </button>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
            {% render 'icon', icon: 'chevron' %}
          </button>
        </div>
      {% endif %}
       {%- if section.settings.show_view_all  -%}
      <div class="view-all center">
        <a href="{{ section.settings.collection.url }}"
          class="button-link"
          aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title }}"
        >
          {% comment %}{{ 'sections.featured_collection.view_all' | t }}{% endcomment %}
           {% if section.settings.view_all_text != blank %}
             {{ section.settings.view_all_text }}
           {% else %}
            {{ 'sections.featured_collection.view_all' | t }}
           {% endif %}
        </a>
      </div>
      {%- endif -%}

      {%- if section.settings.horizontal_scroll -%}
        {%- if section.settings.show_dots_desktop or section.settings.show_dots_mobile -%}
        <div class="slider-dots-wrapper{% if section.settings.show_dots_desktop == false %} small-hide{% endif %}{% if section.settings.show_dots_mobile == false %} large-up-hide{% endif %}">
          <ul class="slider-dots" role="tablist">
            {%- for i in (1..section.settings.products_to_show) -%}
              <li role="presentation">
                <button
                  type="button"
                  class="slider-dot{% if i == 1 %} slider-dot--active{% endif %}"
                  data-index="{{ i }}"
                  aria-label="Go to slide {{ i }}"
                  aria-selected="{% if i == 1 %}true{% else %}false{% endif %}"
                ></button>
              </li>
            {%- endfor -%}
          </ul>
        </div>
        {%- endif -%}
      {%- endif -%}

    </div>

    {%- if section.settings.show_progress_desktop and section.settings.horizontal_scroll -%}
      {%- comment -%} Opt-in segmented scroll indicator (desktop only). Off by default, so other templates are unaffected. {%- endcomment -%}
      <div id="ProgressDesktop-{{ section.id }}" class="fc-progress small-hide" aria-hidden="true"></div>
      <style>
        #shopify-section-{{ section.id }} .fc-progress {
          display: flex;
          justify-content: center;
          gap: 2px;
          padding-top: 32px;
        }
        #shopify-section-{{ section.id }} .fc-progress:empty {
          display: none;
        }
        #shopify-section-{{ section.id }} .fc-progress span {
          width: 50px;
          height: 2px;
          background-color: #d7dde0;
          cursor: pointer;
          transition: background-color 0.3s ease;
        }
        #shopify-section-{{ section.id }} .fc-progress span.is-active {
          background-color: var(--card-text-color);
        }
      </style>
      <script>
        (function () {
          var bar = document.getElementById('ProgressDesktop-{{ section.id }}');
          var list = document.getElementById('Slider-{{ section.id }}');
          if (!bar || !list) return;
          var pages = 0;
          var ticking = false;

          function getMax() {
            return list.scrollWidth - list.clientWidth;
          }

          function update() {
            if (pages < 2) return;
            var max = getMax();
            var active = max > 0 ? Math.round((list.scrollLeft / max) * (pages - 1)) : 0;
            Array.prototype.forEach.call(bar.children, function (segment, index) {
              segment.classList.toggle('is-active', index === active);
            });
          }

          function build() {
            var count = getMax() > 1 ? Math.ceil(list.scrollWidth / list.clientWidth - 0.05) : 0;
            if (count < 2) count = 0;
            if (count !== pages) {
              pages = count;
              bar.innerHTML = '';
              for (var i = 0; i < pages; i++) {
                var segment = document.createElement('span');
                segment.setAttribute('data-index', i);
                segment.addEventListener('click', function () {
                  var index = parseInt(this.getAttribute('data-index'), 10);
                  list.scrollTo({ left: (getMax() * index) / (pages - 1), behavior: 'smooth' });
                });
                bar.appendChild(segment);
              }
            }
            update();
          }

          list.addEventListener('scroll', function () {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(function () {
              ticking = false;
              update();
            });
          }, { passive: true });
          window.addEventListener('resize', build);
          window.addEventListener('load', build);
          build();
        })();
      </script>
    {%- endif -%}

    {%- if section.settings.show_progress_mobile and section.settings.horizontal_scroll -%}
      {%- comment -%}
        Opt-in scroll bar (mobile only): a 50px thumb that slides along a two-segment track as the list scrolls.
        It replaces both dot rows on mobile. Off by default, so other templates are unaffected.
      {%- endcomment -%}
      <div id="ProgressMobile-{{ section.id }}" class="fc-scrollbar medium-hide large-up-hide" aria-hidden="true"><span></span></div>
      <style>
        @media screen and (max-width: 749px) {
          #shopify-section-{{ section.id }} .slider-dots-wrapper,
          #shopify-section-{{ section.id }} .slider-dots {
            display: none !important;
          }
        }
        #shopify-section-{{ section.id }} .fc-scrollbar {
          position: relative;
          width: 102px;
          height: 2px;
          margin: 13px auto 0;
          background: linear-gradient(90deg, #d7dde0 50px, transparent 50px 52px, #d7dde0 52px);
        }
        #shopify-section-{{ section.id }} .fc-scrollbar span {
          position: absolute;
          top: 0;
          left: 0;
          width: 50px;
          height: 100%;
          background-color: #575756;
        }
      </style>
      <script>
        (function () {
          var bar = document.getElementById('ProgressMobile-{{ section.id }}');
          var list = document.getElementById('Slider-{{ section.id }}');
          if (!bar || !list) return;
          var thumb = bar.firstElementChild;
          var ticking = false;

          function update() {
            ticking = false;
            var max = list.scrollWidth - list.clientWidth;
            var progress = max > 0 ? Math.min(Math.max(list.scrollLeft / max, 0), 1) : 0;
            thumb.style.transform = 'translateX(' + progress * 52 + 'px)';
          }

          list.addEventListener('scroll', function () {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(update);
          }, { passive: true });
          window.addEventListener('resize', update);
          update();
        })();
      </script>
    {%- endif -%}


  {% comment %} </div> {% endcomment %}
</div>

<style>
  /*#shopify-section-{{ section.id }} .title {
    font-family: 'Questa Grande', 'Playfair Display', Georgia, serif !important;
    font-weight:400 !important;
  }*/

  #shopify-section-{{ section.id }} .section--padding .slider-mobile-gutter .view-all{
  background-color: var(--viewall-bg-color) !important;
  color: var(--viewall-text-color) !important;
  font-size:14px !important;

{%- style -%}
  @font-face {
    font-family: 'Compacta Pro';
    src: url('https://cdn.shopify.com/s/files/1/0500/1664/9366/files/CompactaProBold.woff2?v=1788008148') format('woff2'),
         url('https://cdn.shopify.com/s/files/1/0500/1664/9366/files/CompactaProBold.woff?v=1788008148') format('woff'),
         url('https://cdn.shopify.com/s/files/1/0500/1664/9366/files/CompactaProBold.ttf?v=1788008148') format('truetype');
    font-weight: 700;
    font-style: normal;
  }

  @font-face {
    font-family: 'Sackers Gothic Std';
    src: url('https://cdn.shopify.com/s/files/1/0500/1664/9366/files/SackersGothicStd.woff2') format('woff2'),
         url('https://cdn.shopify.com/s/files/1/0500/1664/9366/files/SackersGothicStd.woff') format('woff'),
         url('https://cdn.shopify.com/s/files/1/0500/1664/9366/files/SackersGothicStd.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
  }

  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --image-position: {{ section.settings.image_position }};
    --color-highlight: {{ section.settings.colors_highlight.red }}, {{ section.settings.colors_highlight.green }}, {{ section.settings.colors_highlight.blue }};
    --columns-desktop: {{ section.settings.columns_desktop }};
    --card-text-color: {{ section.settings.card_text_color }};
    --card-price-color: {{ section.settings.card_price_color }};
    --card-sales-price-color: {{ section.settings.card_sales_price_color }};
    --card-compare-price-color: {{ section.settings.card_compare_price_color }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --card-badge-text-color: {{ section.settings.card_badge_text_color }};
    --card-badge-bg-color: {{ section.settings.card_badge_bg_color }};
    --vendor-font-weight: {{ section.settings.vendor_font_weight }};
    --viewall-bg-color: {{ section.settings.viewall_bg_color }};
    --viewall-text-color: {{ section.settings.viewall_text_color }};
    --arrow-bg-color: {{ section.settings.arrow_bg_color }};
    --arrow-icon-color: {{ section.settings.arrow_icon_color }};
    --heading-color: {{ section.settings.heading_color }};
    --heading-font-weight: {{ section.settings.heading_font_weight }};
    --heading-font-size: {{ section.settings.heading_font_size | default: 32 }}px;
    --heading-font-size-mobile: {{ section.settings.heading_font_size_mobile | default: 25 }}px;
    --card-text-font-family: {{ section.settings.card_text_font_family }};
    --atc-button-border-radius: {{ section.settings.atc_button_border_radius }};
  }

  /* Heading styling */
  #shopify-section-{{ section.id }} .title {
    color: var(--heading-color) !important;
    font-family: {{ section.settings.heading_font_family }} !important;
    font-weight: var(--heading-font-weight) !important;
    font-size: var(--heading-font-size) !important;
  }

  /* Card text font family */
  #shopify-section-{{ section.id }} .card-information__text,
  #shopify-section-{{ section.id }} .card__heading,
  #shopify-section-{{ section.id }} .product-title {
    font-family: var(--card-text-font-family);
  }

  /* Card text color */
  #shopify-section-{{ section.id }} .card-information__text,
  #shopify-section-{{ section.id }} .card__heading,
  #shopify-section-{{ section.id }} .product-title,
  #shopify-section-{{ section.id }} .card-information h3 {
    color: var(--card-text-color);
  }

  /* Card vendor and text */
  #shopify-section-{{ section.id }} .card-information__caption-with-metadata,
  #shopify-section-{{ section.id }} .caption-with-metadata,
  #shopify-section-{{ section.id }} .card-article-info,
  #shopify-section-{{ section.id }} .caption-with-letter-spacing {
    color: var(--card-text-color);
  }

  /* Vendor font weight */
  #shopify-section-{{ section.id }} .card-article-info,
  #shopify-section-{{ section.id }} .caption-with-letter-spacing {
    font-weight: var(--vendor-font-weight);
  }

  /* Regular price color */
  #shopify-section-{{ section.id }} .price__regular,
  #shopify-section-{{ section.id }} .price__regular .price-item--regular,
  #shopify-section-{{ section.id }} .price__regular .price-item--regular price-money,
  #shopify-section-{{ section.id }} .price__regular price-money {
    color: var(--card-price-color) !important;
  }

  /* Sales price color */
  #shopify-section-{{ section.id }} .price__sale,
  #shopify-section-{{ section.id }} .price__sale .price-item--sale,
  #shopify-section-{{ section.id }} .price__sale .price-item--sale price-money,
  #shopify-section-{{ section.id }} .price__sale price-money {
    color: var(--card-sales-price-color) !important;
  }

  /* Compare price color (strikethrough) */
  #shopify-section-{{ section.id }} .price__compare,
  #shopify-section-{{ section.id }} .price__compare * {
    color: var(--card-compare-price-color) !important;
  }

  #shopify-section-{{ section.id }} dd.price__compare,
  #shopify-section-{{ section.id }} dt.price__compare,
  #shopify-section-{{ section.id }} .price__compare s,
  #shopify-section-{{ section.id }} .price__compare .price-item--regular,
  #shopify-section-{{ section.id }} .price__compare price-money,
  #shopify-section-{{ section.id }} .price__compare bdi {
    color: var(--card-compare-price-color) !important;
  }

  /* Card background */
  #shopify-section-{{ section.id }} .card {
    background-color: var(--card-bg-color);
  }

  /* Desktop columns grid */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .slider-mobile-gutter {
      width: 100%;
      overflow: visible !important;
    }

    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat(var(--columns-desktop), minmax(0, 1fr)) !important;
      overflow-x: visible !important;
      scroll-snap-type: none !important;
      width: 100% !important;
    }

    #shopify-section-{{ section.id }} .grid__item {
      scroll-snap-align: none !important;
    }
  }

  /* Heading highlight span color - inherits font from parent */
  #shopify-section-{{ section.id }} .title span {
    color: rgb(var(--color-highlight));
  }

  /* Badge styling */
  #shopify-section-{{ section.id }} .card__badge span {
    background-color: var(--card-badge-bg-color);
    color: var(--card-badge-text-color);
    border-color:var(--card-badge-bg-color);
    border-radius: {{ section.settings.badge_border_radius }} !important;
  }

  {%- if section.settings.atc_button_bg != blank and section.settings.atc_button_bg != 'rgba(0,0,0,0)' -%}
    #shopify-section-{{ section.id }} .card-information__button .button,
    #shopify-section-{{ section.id }} .card-information__button add-to-cart,
    #shopify-section-{{ section.id }} .card-information__button quick-view-button {
      background-color: {{ section.settings.atc_button_bg }};
      border-color: {{ section.settings.atc_button_bg }};
      border-radius: var(--atc-button-border-radius);
    }
    #shopify-section-{{ section.id }} .card-information__button .button:hover,
    #shopify-section-{{ section.id }} .card-information__button add-to-cart:hover,
    #shopify-section-{{ section.id }} .card-information__button quick-view-button:hover {
      background-color: {{ section.settings.atc_button_bg }};
      border-color: {{ section.settings.atc_button_bg }};
      opacity: 0.85;
    }
  {%- endif -%}

  {%- if section.settings.atc_button_text != blank and section.settings.atc_button_text != 'rgba(0,0,0,0)' -%}
    #shopify-section-{{ section.id }} .card-information__button .button,
    #shopify-section-{{ section.id }} .card-information__button add-to-cart,
    #shopify-section-{{ section.id }} .card-information__button quick-view-button {
      color: {{ section.settings.atc_button_text }};
    }
    #shopify-section-{{ section.id }} .card-information__button .button svg,
    #shopify-section-{{ section.id }} .card-information__button add-to-cart svg,
    #shopify-section-{{ section.id }} .card-information__button quick-view-button svg {
      fill: {{ section.settings.atc_button_text }};
      color: {{ section.settings.atc_button_text }};
    }
  {%- endif -%}

  /* Slider Dots */
  #shopify-section-{{ section.id }} .slider-dots-wrapper {
    display: flex;
    justify-content: center;
    padding: 20px 0;
  }

  #shopify-section-{{ section.id }} .slider-dots {
    display: flex !important;
    justify-content: center !important;
    gap: 12px;
    margin: 0 !important;
    padding: 0 !important;
    flex-wrap: wrap;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .slider-dot {
    width: 50px;
    height: 2px;
    border-radius: 0%;
    background-color: #9BACBE;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .slider-dot:hover {
    background-color: #999999;
  }

  #shopify-section-{{ section.id }} .slider-dot--active {
    background-color: rgb(var(--color-highlight));
  }

  /* Arrow button styling */
  #shopify-section-{{ section.id }} .slider-button {
    background-color: var(--arrow-bg-color);
  }

  #shopify-section-{{ section.id }} .slider-button svg,
  #shopify-section-{{ section.id }} .slider-button .icon {
    color: var(--arrow-icon-color);
    fill: var(--arrow-icon-color);
    stroke: var(--arrow-icon-color);
  }

{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sliderDots = document.querySelectorAll('#shopify-section-{{ section.id }} .slider-dot');
    const slider = document.getElementById('Slider-{{ section.id }}');
    const nextButton = document.querySelector('#shopify-section-{{ section.id }} .slider-button--next');
    const prevButton = document.querySelector('#shopify-section-{{ section.id }} .slider-button--prev');

    if (!slider || !sliderDots.length || !nextButton || !prevButton) return;

    const slideItems = slider.querySelectorAll('[id^="Slide-{{ section.id }}-"]');
    let currentSlide = 1;

    function updateActiveDot(slideIndex) {
      sliderDots.forEach(d => d.classList.remove('slider-dot--active'));
      const activeDot = document.querySelector('#shopify-section-{{ section.id }} .slider-dot[data-index="' + slideIndex + '"]');
      if (activeDot) {
        activeDot.classList.add('slider-dot--active');
      }
    }

    function scrollToSlide(slideIndex) {
      const slide = document.getElementById('Slide-{{ section.id }}-' + slideIndex);
      if (slide) {
        slide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        currentSlide = slideIndex;
        updateActiveDot(slideIndex);
      }
    }

    // Handle dot clicks
    sliderDots.forEach(dot => {
      dot.addEventListener('click', function() {
        const targetSlide = parseInt(this.getAttribute('data-index'));
        scrollToSlide(targetSlide);
      });
    });

    // Track slider scroll to update active dot
    let scrollTimeout;
    slider.addEventListener('scroll', function() {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        let closestSlide = 1;
        let closestDistance = Infinity;

        slideItems.forEach((slide, index) => {
          const rect = slide.getBoundingClientRect();
          const sliderRect = slider.getBoundingClientRect();
          const distance = Math.abs(rect.left - sliderRect.left);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestSlide = index + 1;
          }
        });

        if (closestSlide !== currentSlide) {
          currentSlide = closestSlide;
          updateActiveDot(closestSlide);
        }
      }, 100);
    }, { passive: true });
  });
</script>


                            {% if block.settings.text_font_weight %}font-weight: {{ block.settings.text_font_weight }} !important;{% endif %}
                            {% if block.settings.text_font_style %}font-style: {{ block.settings.text_font_style }} !important;{% endif %}
                            {% if block.settings.text_line_height %}line-height: {{ block.settings.text_line_height }} !important;{% endif %}
                            {% if block.settings.text_letter_spacing %}letter-spacing: {{ block.settings.text_letter_spacing }} !important;{% endif %}
                          "
                        >
                          {%- render 'highlight-text', hl_input: block.settings.text, hl_animateWrap: true -%}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </li>
            {% when 'number' %}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %} {{ section.settings.text_alignment }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.title != blank
                  or block.settings.number1
                  or block.settings.text1
                  or block.settings.number2
                  or block.settings.text2
                  or block.settings.number3
                  or block.settings.text3
                -%}
                  <div
                    class="multicolumn-card number-boxx"
                    style="
                      {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
                      {% if block.settings.border_width > 0 %}border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};{% endif %}
                    "
                  >
                    <img src="{{ 'circle.png' | asset_url }}">
                    <div class="multicolumn-card__info column-number-box" style="justify-content: {{ block.settings.content_alignment }};">
                      {% if block.settings.title != blank %}<div class="multicolumn-card__title-wrapper">
                        <p
                          class="multicolumn-card__title"
                          style="
                            {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                            {% if block.settings.heading_font_family %}font-family: {{ block.settings.heading_font_family }} !important;{% endif %}
                            {% if block.settings.heading_font_weight %}font-weight: {{ block.settings.heading_font_weight }} !important;{% endif %}
                            {% if block.settings.heading_font_style %}font-style: {{ block.settings.heading_font_style }} !important;{% endif %}
                            {% if block.settings.heading_line_height %}line-height: {{ block.settings.heading_line_height }} !important;{% endif %}
                            {% if block.settings.heading_letter_spacing %}letter-spacing: {{ block.settings.heading_letter_spacing }} !important;{% endif %}
                          "
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="19"
                            height="27"
                            viewBox="0 0 19 27"
                            fill="none"
                          >
                            <path d="M15.1875 5.35156C17.0708 5.35156 18.6875 6.96823 18.6875 8.85156C18.6875 10.7349 17.0708 12.3516 15.1875 12.3516C13.3042 12.3516 11.6875 10.7391 11.6875 8.85156C11.6875 6.96406 13.3042 5.35156 15.1875 5.35156Z" fill="white"/>
                            <path d="M7.1875 0.351562C8.534 0.351562 9.6875 1.50506 9.6875 2.85156C9.6875 4.19806 8.534 5.35156 7.1875 5.35156C5.841 5.35156 4.6875 4.19806 4.6875 2.85156C4.6875 1.50506 5.841 0.351562 7.1875 0.351562Z" fill="white"/>
                            <path d="M7.6875 11.3516C11.4543 11.3516 14.6875 14.8115 14.6875 18.8516C14.6875 22.8916 11.4582 26.3516 7.6875 26.3516C3.91676 26.3516 0.6875 22.8874 0.6875 18.8516C0.6875 14.8157 3.91676 11.3516 7.6875 11.3516Z" fill="white"/>
                          </svg>
                          {%- render 'highlight-text', hl_input: block.settings.title, hl_animateWrap: true -%}
                        </p>
                      </div>{% endif %}
                      {% if block.settings.number1 or block.settings.text1 %}
                        <div class="text_number">
                          <h2
                            style="
                              {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                              {% if block.settings.number_font_family %}font-family: {{ block.settings.number_font_family }} !important;{% endif %}
                              {% if block.settings.number_font_weight %}font-weight: {{ block.settings.number_font_weight }} !important;{% endif %}
                              {% if block.settings.number_font_style %}font-style: {{ block.settings.number_font_style }} !important;{% endif %}
                              {% if block.settings.number_line_height %}line-height: {{ block.settings.number_line_height }} !important;{% endif %}
                              {% if block.settings.number_letter_spacing %}letter-spacing: {{ block.settings.number_letter_spacing }} !important;{% endif %}
                            "
                          >
                            {{ block.settings.number1 }}
                          </h2>
                          <p
                            style="
                              {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                              {% if block.settings.text_font_family %}font-family: {{ block.settings.text_font_family }} !important;{% endif %}
                              {% if block.settings.text_font_weight %}font-weight: {{ block.settings.text_font_weight }} !important;{% endif %}
                              {% if block.settings.text_font_style %}font-style: {{ block.settings.text_font_style }} !important;{% endif %}
                              {% if block.settings.text_line_height %}line-height: {{ block.settings.text_line_height }} !important;{% endif %}
                              {% if block.settings.text_letter_spacing %}letter-spacing: {{ block.settings.text_letter_spacing }} !important;{% endif %}
                            "
                          >
                            {{ block.settings.text1 }}
                          </p>
                        </div>
                      {% endif %}
                      {% if block.settings.number2 or block.settings.text2 %}
                        <div class="text_number">
                          <h2
                            style="
                              {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                              {% if block.settings.number_font_family %}font-family: {{ block.settings.number_font_family }} !important;{% endif %}
                              {% if block.settings.number_font_weight %}font-weight: {{ block.settings.number_font_weight }} !important;{% endif %}
                              {% if block.settings.number_font_style %}font-style: {{ block.settings.number_font_style }} !important;{% endif %}
                              {% if block.settings.number_line_height %}line-height: {{ block.settings.number_line_height }} !important;{% endif %}
                              {% if block.settings.number_letter_spacing %}letter-spacing: {{ block.settings.number_letter_spacing }} !important;{% endif %}
                            "
                          >
                            {{ block.settings.number2 }}
                          </h2>
                          <p
                            style="
                              {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                              {% if block.settings.text_font_family %}font-family: {{ block.settings.text_font_family }} !important;{% endif %}
                              {% if block.settings.text_font_weight %}font-weight: {{ block.settings.text_font_weight }} !important;{% endif %}
                              {% if block.settings.text_font_style %}font-style: {{ block.settings.text_font_style }} !important;{% endif %}
                              {% if block.settings.text_line_height %}line-height: {{ block.settings.text_line_height }} !important;{% endif %}
                              {% if block.settings.text_letter_spacing %}letter-spacing: {{ block.settings.text_letter_spacing }} !important;{% endif %}
                            "
                          >
                            {{ block.settings.text2 }}
                          </p>
                        </div>
                      {% endif %}
                      {% if block.settings.number3 or block.settings.text3 %}
                        <div class="text_number">
                          <h2
                            style="
                              {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                              {% if block.settings.number_font_family %}font-family: {{ block.settings.number_font_family }} !important;{% endif %}
                              {% if block.settings.number_font_weight %}font-weight: {{ block.settings.number_font_weight }} !important;{% endif %}
                              {% if block.settings.number_font_style %}font-style: {{ block.settings.number_font_style }} !important;{% endif %}
                              {% if block.settings.number_line_height %}line-height: {{ block.settings.number_line_height }} !important;{% endif %}
                              {% if block.settings.number_letter_spacing %}letter-spacing: {{ block.settings.number_letter_spacing }} !important;{% endif %}
                            "
                          >
                            {{ block.settings.number3 }}
                          </h2>
                          <p
                            style="
                              {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                              {% if block.settings.text_font_family %}font-family: {{ block.settings.text_font_family }} !important;{% endif %}
                              {% if block.settings.text_font_weight %}font-weight: {{ block.settings.text_font_weight }} !important;{% endif %}
                              {% if block.settings.text_font_style %}font-style: {{ block.settings.text_font_style }} !important;{% endif %}
                              {% if block.settings.text_line_height %}line-height: {{ block.settings.text_line_height }} !important;{% endif %}
                              {% if block.settings.text_letter_spacing %}letter-spacing: {{ block.settings.text_letter_spacing }} !important;{% endif %}
                            "
                          >
                            {{ block.settings.text3 }}
                          </p>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </li>
            {% when 'video' %}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %} {{ section.settings.text_alignment }}"
                {{ block.shopify_attributes }}
              >
                <div
                  class="multicolumn-card"
                  style="
                    {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
                    {% if block.settings.border_width > 0 %}border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};{% endif %}
                  "
                >
                  {%- if block.settings.image != blank or block.settings.youtube_link != blank -%}
                    <use-animate
                      data-animate="zoom-fade"
                      class="media-wrapper multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' %} multicolumn-card-spacing{% endif %}"
                    >
                      <div
                        class="image-animate media media--{{ section.settings.image_ratio }}"
                        {%- if section.settings.image_ratio == 'adapt' %}
                          style="--image-ratio-percent: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                        {% endif -%}
                      >
                        {%- if block.settings.video_poster != blank -%}
                          <multicolumn-video-item
                            class="video-wrapper"
                            data-video-id="{{ block.settings.video.id }}"
                            data-preview-duration="900"
                          >
                            {% comment %}
                              <video
                                class="multicolumn-card__video"
                                playsinline
                                loop
                                muted
                                {% if block.settings.video_poster != blank %}
                                  poster="{{ block.settings.video_poster | image_url: width: 2000 }}"
                                {% endif %}
                              >
                                <source src="{{ block.settings.video.sources[1].url }}" type="video/mp4">
                              </video>
                              <button class="video-play-button" aria-label="Play video">
                                <span class="play-icon">{% render 'icon', icon: 'play-alt' %}</span>
                                <span class="pause-icon">{% render 'icon', icon: 'pause' %}</span>
                              </button>
                            {% endcomment %}
                            <div class="youtube-video-wrapper">
                              <div class="youtube-thumbnail" style="position: relative;">
                                {% if block.settings.video_poster != blank %}
                                  <img
                                    src="{{ block.settings.video_poster | image_url: width: 2000 }}"
                                    alt="Video Thumbnail"
                                    class="youtube-thumb-image"
                                  >
                                {% endif %}

                                <button
                                  class="video-play-button"
                                  id="{{ block.id }}"
                                  aria-label="Play video"
                                  data-youtube="{{ block.settings.youtube_link }}"
                                  style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border: none; background: none; cursor: pointer;"
                                >
                                  <span class="play-icon">{% render 'icon', icon: 'play-alt' %}</span>
                                </button>
                              </div>
                            </div>

                            <script>
                              document.addEventListener('DOMContentLoaded', function () {
                                const modal = document.getElementById('youtube-modal');
                                const iframe = document.getElementById('youtube-frame');
                                const closeBtn = document.querySelector('.youtube-close');
                                const playButtons = document.querySelectorAll('#{{ block.id }}'); // Use a class instead of block.id for multiple buttons

                                playButtons.forEach((button) => {
                                  button.addEventListener('click', function (e) {
                                    e.preventDefault();
                                    const youtubeLink = this.getAttribute('data-youtube');

                                    let videoId = '';

                                    // Case 1: Normal YouTube video link (e.g. ?v=abc123)
                                    if (youtubeLink.includes('v=')) {
                                      videoId = youtubeLink.split('v=')[1].split('&')[0];
                                    }
                                    // Case 2: YouTube Shorts link (e.g. /shorts/abc123)
                                    else if (youtubeLink.includes('/shorts/')) {
                                      videoId = youtubeLink.split('/shorts/')[1].split('?')[0];
                                    }

                                    // Build embed URL
                                    const embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;

                                    iframe.src = embedUrl;
                                    modal.style.display = 'block';
                                    document.body.style.overflow = 'hidden';
                                  });
                                });

                                // Close modal
                                closeBtn.addEventListener('click', function () {
                                  modal.style.display = 'none';
                                  iframe.src = '';
                                  document.body.style.overflow = 'auto';
                                });

                                // Close on background click
                                modal.addEventListener('click', function (e) {
                                  if (e.target === modal) {
                                    modal.style.display = 'none';
                                    iframe.src = '';
                                    document.body.style.overflow = 'auto';
                                  }
                                });
                              });
                            </script>

                            {%- if block.settings.title != blank -%}
                              <p
                                class="video__title {{ block.settings.title_size }}"
                                {% if block.settings.heading_color != blank %}
                                  style="color: {{ block.settings.heading_color }};"
                                {% endif %}
                              >
                                {%- render 'highlight-text', hl_input: block.settings.title, hl_animateWrap: true -%}
                              </p>
                            {%- endif -%}
                          </multicolumn-video-item>
                        {%- else -%}
                          {%- liquid
                            assign number_of_columns = section.settings.columns_desktop
                            assign number_of_columns_mobile = section.settings.columns_mobile
                            assign grid_space_desktop = number_of_columns | minus: 1 | times: 30 | plus: 100 | append: 'px'
                            assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: 30 | plus: 100 | append: 'px'
                            assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: 30 | divided_by: 2 | plus: 30 | append: 'px'
                            if section.settings.image_width == 'half'
                              assign image_width = 0.5
                            elsif section.settings.image_width == 'third'
                              assign image_width = 0.33
                            else
                              assign image_width = 1
                            endif
                          -%}
                          {% capture sizes %}
                        (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                        (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                        (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                        calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                      {% endcapture %}
                          {{
                            block.settings.image
                            | image_url: width: 3200
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                              sizes: sizes,
                              class: 'multicolumn-card__image',
                              is: 'lazy-image'
                          }}
                        {%- endif -%}
                      </div>
                    </use-animate>
                  {%- endif -%}
                </div>
                <style>
                  {% if block.settings.align %}  #Slide-{{ section.id }}-{{ forloop.index }} .multicolumn-card__title-wrapper{
                       justify-content:{{ block.settings.align }};
                   }{% endif %}
                </style>
              </li>

            {% when 'image' %}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %} {{ section.settings.text_alignment }}"
                {{ block.shopify_attributes }}
              >
                <div
                  class="multicolumn-card hover-card"
                  style="
                    {% if block.settings.background_color != blank %}background-color: {{ block.settings.background_color }};{% endif %}
                    {% if block.settings.border_width > 0 %}border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};{% endif %}
                  "
                >
                  {%- if block.settings.image != blank or block.settings.video != blank -%}
                    <use-animate
                      data-animate="zoom-fade"
                      class="media-wrapper multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' %} multicolumn-card-spacing{% endif %}"
                    >
                      <div
                        class="image-animate media media--{{ section.settings.image_ratio }}"
                        {%- if section.settings.image_ratio == 'adapt' %}
                          style="--image-ratio-percent: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                        {% endif -%}
                      >
                        {%- liquid
                          assign number_of_columns = section.settings.columns_desktop
                          assign number_of_columns_mobile = section.settings.columns_mobile
                          assign grid_space_desktop = number_of_columns | minus: 1 | times: 30 | plus: 100 | append: 'px'
                          assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: 30 | plus: 100 | append: 'px'
                          assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: 30 | divided_by: 2 | plus: 30 | append: 'px'
                          if section.settings.image_width == 'half'
                            assign image_width = 0.5
                          elsif section.settings.image_width == 'third'
                            assign image_width = 0.33
                          else
                            assign image_width = 1
                          endif
                        -%}
                        {% capture sizes %}
                        (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                        (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                        (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                        calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                      {% endcapture %}
                        {{
                          block.settings.image
                          | image_url: width: 3200
                          | image_tag:
                            loading: 'lazy',
                            widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                            sizes: sizes,
                            class: 'multicolumn-card__image',
                            is: 'lazy-image'
                        }}
                      </div>
                     {%- if block.settings.title != blank
                            or block.settings.text != blank
                            or block.settings.button_label != blank
                          -%} 
                      <div class="hover-box">
                        <div class="border-box">
                          
                            <p
                              class="multicolumn-card__title {{ block.settings.title_size }}"
                              style="
                                {% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}
                                {% if block.settings.heading_font_family %}font-family: {{ block.settings.heading_font_family }} !important;{% endif %}
                                {% if block.settings.heading_font_weight %}font-weight: {{ block.settings.heading_font_weight }} !important;{% endif %}
                                {% if block.settings.heading_line_height %}line-height: {{ block.settings.heading_line_height }} !important;{% endif %}
                                {% if block.settings.heading_letter_spacing %}letter-spacing: {{ block.settings.heading_letter_spacing }} !important;{% endif %}
                              "
                            >
                              {%- render 'highlight-text',
                                hl_input: block.settings.title,
                                hl_style: block.settings.highlight_style,
                                hl_enable: block.settings.enable_highlight,
                                hl_animateWrap: true
                              -%}
                            </p>
                          
                          {%- if block.settings.url_link != blank -%}
                            <a href="{{ block.settings.url_link }}" class="read-link">Read More</a>
                          {%- endif -%}
                        </div>
                      </div>{% endif %}
                    </use-animate>
                  {%- endif -%}
                </div>
              </li>
          {% endcase %}
        {%- endfor -%}
      </ul>

      <div class="slider-buttons no-js-hidden small-hide">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
          disabled="disabled"
        >
          {% render 'icon', icon: 'chevron' %}
        </button>
        <button
          type="button"
          class="slider-button slider-button--next"
          name="next"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          {% render 'icon', icon: 'chevron' %}
        </button>
      </div>
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Saicho - Brand columns",
  "tag": "section",
  "class": "section brands-multicolumn brand-column",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:sections.brands-multicolumn.settings.background-color.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [

{%- liquid
  if section.blocks.size > 0
    assign first_block = section.blocks | first
  endif
  assign image_behavior = section.settings.image_behavior
-%}

{%- capture css_variables -%}
  --color-background: {{ section.settings.colors_background.red }}, {{ section.settings.colors_background.green }}, {{ section.settings.colors_background.blue }};
  --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
  --color-link: var(--color-foreground);
  --color-border: var(--color-foreground);
  --color-heading: var(--color-foreground);
  --color-button-background: {{ section.settings.colors_button_background.red }}, {{ section.settings.colors_button_background.green }}, {{ section.settings.colors_button_background.blue }};
  --color-button-text: {{ section.settings.colors_button_label.red }}, {{ section.settings.colors_button_label.green }}, {{ section.settings.colors_button_label.blue }};
  --color-button-border: var(--color-button-background);
  --color-shadow: var(--color-foreground);
  --shadow-opacity: 0.3;
{%- endcapture -%}

{%- style -%}


  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if first_block and first_block.settings.image or first_block.settings.video %}
      {%- if first_block.settings.image %}
        --image-ratio-percent: {{ 1 | divided_by: first_block.settings.image.aspect_ratio | times: 100 }}%;
      {% elsif first_block.settings.video %}
        --image-ratio-percent: {{ 1 | divided_by: first_block.settings.video.aspect_ratio | times: 100 }}%;
      {% endif -%}
    {% endif -%}
    --image-height: {{ section.settings.mobile_image_ratio }};
    --color-overlay-opacity: {{ section.settings.colors_overlay_opacity | divided_by: 100.0 }};
    --color-overlay: {{ section.settings.colors_overlay.red }}, {{ section.settings.colors_overlay.green }}, {{ section.settings.colors_overlay.blue }};
    --color-highlight: {{ section.settings.colors_highlight.red }}, {{ section.settings.colors_highlight.green }}, {{ section.settings.colors_highlight.blue }};
    {%- unless section.settings.show_text_below %}
      {{ css_variables }}
    {% endunless -%}
  }
  #shopify-section-{{ section.id }} .slideshow__heading {
    font-weight: 700;
    font-family: 'CORONABRUSH400';
    font-size: 58px;
    text-transform: uppercase;
    line-height:85%;
  letter-spacing:-5%;

  }

  #shopify-section-{{ section.id }} .slideshow__heading-image {
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .slideshow__heading-image img {
    max-width: 100%;
    height: auto;
    display: inline-block;
  }
    #shopify-section-{{ section.id }} .slideshow__box {
        bottom: 0%;
    
    }
  {%- for block in section.blocks -%}
    #shopify-section-{{ section.id }} .slideshow__box-{{ block.id }} {
      justify-content: {{ block.settings.content_justify }};
    }
    #shopify-section-{{ section.id }} .slideshow__box-{{ block.id }} .slideshow__card {
      text-align: {{ block.settings.content_text_align }};
    }
    {%- if block.settings.heading_color != blank and block.settings.heading_color != 'rgba(0,0,0,0)' -%}
      #shopify-section-{{ section.id }} .slideshow__box-{{ block.id }} .slideshow__heading {
        color: {{ block.settings.heading_color }};
      }
    {%- endif -%}
    {%- if block.settings.subheading_color != blank and block.settings.subheading_color != 'rgba(0,0,0,0)' -%}
      #shopify-section-{{ section.id }} .slideshow__box-{{ block.id }} .slideshow__subheading {
        color: {{ block.settings.subheading_color }};
            font-weight: 600;
    letter-spacing: -2.5%;
    font-size: 44px;
      }
    {%- endif -%}
    {%- if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' -%}
      #shopify-section-{{ section.id }} .slideshow__box-{{ block.id }} .slideshow__text {
        color: {{ block.settings.text_color }};
      }
    {%- endif -%}
    {%- if block.settings.custom_css != blank -%}
  #shopify-section-{{ section.id }} .slideshow__box-{{ block.id }} {
    {{ block.settings.custom_css }}
  }
{%- endif -%}

  {%- endfor -%}

  {%- if first_block and first_block.settings.image_mobile -%}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        --image-ratio-percent: {{ 1 | divided_by: first_block.settings.image_mobile.aspect_ratio | times: 100 }}%;
      }
    }
  {%- endif -%}
  :where(#shopify-section-{{ section.id }} .slideshow__right .slideshow__slide) {
    position: relative;
  }
#shopify-section-{{ section.id }} .slideshow__stamp {
  position: absolute;
  z-index: 3;
  line-height: 0;
  pointer-events: none;
}
#shopify-section-{{ section.id }} .slideshow__stamp img {
  height: auto;
}
#shopify-section-{{ section.id }} .slideshow__stamp--top-left { top: 3rem; left: 3rem; }
#shopify-section-{{ section.id }} .slideshow__stamp--top-center { top: 3rem; left: 50%; transform: translateX(-50%); }
#shopify-section-{{ section.id }} .slideshow__stamp--top-right { top: 3rem; right: 3rem; }
#shopify-section-{{ section.id }} .slideshow__stamp--middle-left { top: 50%; left: 3rem; transform: translateY(-50%); }
#shopify-section-{{ section.id }} .slideshow__stamp--middle-center { top: 50%; left: 50%; transform: translate(-50%, -50%); }
#shopify-section-{{ section.id }} .slideshow__stamp--middle-right { top: 50%; right: 3rem; transform: translateY(-50%); }
#shopify-section-{{ section.id }} .slideshow__stamp--bottom-left { bottom: 3rem; left: 3rem; }
#shopify-section-{{ section.id }} .slideshow__stamp--bottom-center { bottom: 3rem; left: 50%; transform: translateX(-50%); }
#shopify-section-{{ section.id }} .slideshow__stamp--bottom-right { bottom: 3rem; right: 3rem; }

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .slideshow__stamp img {
    width: calc(var(--stamp-width) * 0.6) !important;
  }
  
}
   @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .slideshow__card {
        max-width: 80.6rem;
    }
}
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --image-height: {{ section.settings.image_ratio }};
      {% if section.settings.show_text_below %}
        {{ css_variables }}
      {% endif %}
    }

    #shopify-section-{{ section.id }} .flickity-button {
      --color-button-text: {{ section.settings.colors_navigation_text.red }}, {{ section.settings.colors_navigation_text.green }}, {{ section.settings.colors_navigation_text.blue }};
      --color-button-background: {{ section.settings.colors_navigation_background.red }}, {{ section.settings.colors_navigation_background.green }}, {{ section.settings.colors_navigation_background.blue }};;
      --color-button-border: var(--color-button-background);
    }

    #shopify-section-{{ section.id }} .slideshow--legacy[data-autorotate="true"] .flickity-page-dots .flickity-page-dot::before {
      animation-duration: {{ section.settings.autorotate_speed }}s;
    }
  }
{%- endstyle -%}

{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}

<div class="page-width{% if section.settings.full_width %} page-width--full-width{% endif %}{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %} section--padding">
  {%- if section.blocks.size > 1 -%}
    <slideshow-component id="Slideshow-{{ section.id }}" class="slideshow slideshow--{{ section.settings.slideshow_type }} slideshow--{{ section.settings.image_ratio }} slideshow--mobile-{{ section.settings.mobile_image_ratio }}{% unless section.settings.show_text_below %} slideshow--mobile-overlay{% endunless %}" data-autorotate="{{ section.settings.autorotate }}" data-autorotate-speed="{{ section.settings.autorotate_speed | times: 1000 }}">
      <div class="slideshow__left">
        {%- liquid
          assign offset = 0
          assign limit = slide_count
          assign slide_count = section.blocks.size

          if slide_count > 1
            assign offset = slide_count | minus: 1
            assign limit = 1
          endif
        -%}

        {%- for block in section.blocks offset: offset limit: limit -%}
          <div class="slideshow__slide">
            {%- case block.type -%}
              {%- when 'image' -%}
                {% render 'slide-image', block: block, position: forloop.index, image_behavior: image_behavior, loading: 'lazy', fetchpriority: 'low' %}
              {%- when 'video' -%}
                {% render 'slide-video', block: block, position: forloop.index, image_behavior: image_behavior, section: section %}
            {%- endcase -%}
          </div>
        {%- endfor -%}

        {%- if slide_count > 1 -%}
          {%- liquid
            assign offset = 0
            assign limit = slide_count | minus: 1
          -%}

          {%- for block in section.blocks offset: offset limit: limit -%}
            <div class="slideshow__slide">
              {%- case block.type -%}
                {%- when 'image' -%}
                  {% render 'slide-image', block: block, position: forloop.index, image_behavior: image_behavior, loading: 'lazy', fetchpriority: 'low' %}
                {%- when 'video' -%}
                  {% render 'slide-video', block: block, position: forloop.index, image_behavior: image_behavior, section: section %}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="slideshow__center {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }} page-width">
        <div class="slideshow__content">
          {%- for block in section.blocks -%}
            <div class="slideshow__box slideshow__box-{{ block.id }} slideshow__box--{{ block.settings.text_box_position }} page-width">
              <div class="slideshow__card">
                {%- assign animate_delay = 1 -%}
                {% if block.settings.image_logo != blank %}
                  <div class="logo-img"><img src="{{ block.settings.image_logo | img_url:'original' }}" /></div>
                {% endif %}
                {%- if block.settings.heading_image != blank -%}
                  <div class="slideshow__heading-image" data-animate data-animate-delay-{{ animate_delay }}>
                    <img
                      src="{{ block.settings.heading_image | image_url: width: 1200 }}"
                      alt="{{ block.settings.heading | strip_html | escape }}"
                      style="width: {{ block.settings.heading_image_width | default: 400 }}px;"
                      loading="lazy"
                    >
                  </div>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- elsif block.settings.heading != blank -%}
                  <{{ block.settings.heading_tag }} class="slideshow__heading {{ block.settings.heading_size }}" data-animate data-animate-delay-{{ animate_delay }}>
                    {%- render 'highlight-text', 
                      hl_input: block.settings.heading, 
                      hl_style: block.settings.highlight_style,
                      hl_enable: block.settings.enable_highlight,
                      hl_animateWrap: true -%}
                  </{{ block.settings.heading_tag }}>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="slideshow__subheading {{ block.settings.subheading_size }}" data-animate data-animate-delay-{{ animate_delay }}>
                    {%- render 'highlight-text', 
                      hl_input: block.settings.subheading, 
                      hl_style: block.settings.highlight_style,
                      hl_enable: block.settings.enable_highlight,
                      hl_animateWrap: true -%}
                  </p>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="slideshow__text {{ block.settings.text_size }}" data-animate data-animate-delay-{{ animate_delay }}>
                    {%- render 'highlight-text', 
                      hl_input: block.settings.text, 
                      hl_style: block.settings.highlight_style,
                      hl_enable: block.settings.enable_highlight,
                      hl_animateWrap: true -%}
                  </div>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.button_label != blank or block.settings.button_alt_label != blank -%}
                  <div class="slideshow__button" data-animate data-animate-delay-{{ animate_delay }}>
                    <div class="button-group">
                      {%- if block.settings.button_label != blank -%}
                        {%- if block.settings.button_style_secondary -%}
                          <a class="button button--cta button--{{ block.settings.button_size }} mobile:button--small"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                            <span class="label">{{ block.settings.button_label | escape }}</span>
                            {% render 'icon', icon: 'arrow' %}
                          </a>
                        {%- else -%}
                          <a class="button button--{{ block.settings.button_size }} mobile:button--small"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                            {{ block.settings.button_label | escape }}
                          </a>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if block.settings.button_alt_label != blank -%}
                        {%- if block.settings.button_alt_style_secondary -%}
                          <a class="button button--cta button--{{ block.settings.button_alt_size }} mobile:button--small"{% if block.settings.button_alt_link != blank %} href="{{ block.settings.button_alt_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                            <span class="label">{{ block.settings.button_alt_label | escape }}</span>
                            {% render 'icon', icon: 'arrow' %}
                          </a>
                        {%- else -%}
                          <a class="button button--secondary button--{{ block.settings.button_alt_size }} mobile:button--small"{% if block.settings.button_alt_link != blank %} href="{{ block.settings.button_alt_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                            {{ block.settings.button_alt_label | escape }}
                          </a>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="slideshow__right">
        {%- for block in section.blocks -%}
          {%- liquid
            if forloop.first and section.index == 1
              assign loading = 'eager'
              assign fetchpriority = 'high'
            else
              assign loading = 'lazy'
              assign fetchpriority = 'low'
            endif
          -%}
          <div class="slideshow__slide" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'image' -%}
                {% render 'slide-image', block: block, position: forloop.index, image_behavior: image_behavior, loading: loading, fetchpriority: fetchpriority %}
              {%- when 'video' -%}
                {% render 'slide-video', block: block, position: forloop.index, image_behavior: image_behavior, section: section %}
            {%- endcase -%}
            {%- if block.settings.stamp_image != blank -%}
              <div class="slideshow__stamp slideshow__stamp--{{ block.settings.stamp_position | default: 'middle-right' }}">
                <img
                  src="{{ block.settings.stamp_image | image_url: width: 600 }}"
                  alt="{{ block.settings.stamp_image.alt | escape }}"
                  style="width: {{ block.settings.stamp_width | default: 188 }}px; --stamp-width: {{ block.settings.stamp_width | default: 188 }}px;"
                  loading="lazy"
                >
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </slideshow-component>
  {%- elsif section.blocks.size == 1 -%}
    <div id="Slideshow-{{ section.id }}" class="slideshow slideshow--only1 slideshow--{{ section.settings.slideshow_type }} slideshow--{{ section.settings.image_ratio }} slideshow--mobile-{{ section.settings.mobile_image_ratio }}{% unless section.settings.show_text_below %} slideshow--mobile-overlay{% endunless %}">
      {%- assign block = section.blocks.first -%}
      <div class="slideshow__center {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }} page-width">
        {%- if block.settings.subheading != blank or block.settings.heading != blank or block.settings.heading_image != blank or block.settings.text != blank or block.settings.button_label != blank -%}
          <div class="slideshow__content">
            <div class="slideshow__box slideshow__box-{{ block.id }} slideshow__box--{{ block.settings.text_box_position }} is-selected page-width">
              <div class="slideshow__card">
                {%- assign animate_delay = 1 -%}

                {%- if block.settings.heading_image != blank -%}
                  <div class="slideshow__heading-image" data-animate data-animate-delay-{{ animate_delay }}>
                    <img
                      src="{{ block.settings.heading_image | image_url: width: 1200 }}"
                      alt="{{ block.settings.heading | strip_html | escape }}"
                      style="width: {{ block.settings.heading_image_width | default: 400 }}px;"
                      loading="lazy"
                    >
                  </div>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- elsif block.settings.heading != blank -%}
                  <{{ block.settings.heading_tag }} class="slideshow__heading {{ block.settings.heading_size }}" data-animate data-animate-delay-{{ animate_delay }}>
                    {%- render 'highlight-text', 
                      hl_input: block.settings.heading, 
                      hl_style: block.settings.highlight_style,
                      hl_enable: block.settings.enable_highlight,
                      hl_animateWrap: true -%}
                  </{{ block.settings.heading_tag }}>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="slideshow__subheading {{ block.settings.subheading_size }}" data-animate data-animate-delay-{{ animate_delay }}>
                    {%- render 'highlight-text', 
                      hl_input: block.settings.subheading, 
                      hl_style: block.settings.highlight_style,
                      hl_enable: block.settings.enable_highlight,
                      hl_animateWrap: true -%}
                  </p>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="slideshow__text {{ block.settings.text_size }}" data-animate data-animate-delay-{{ animate_delay }}>
                    {%- render 'highlight-text', 
                      hl_input: block.settings.text, 
                      hl_style: block.settings.highlight_style,
                      hl_enable: block.settings.enable_highlight,
                      hl_animateWrap: true -%}
                  </div>
                  {%- assign animate_delay = animate_delay | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.button_label != blank or block.settings.button_alt_label != blank -%}
                  <div class="slideshow__button" data-animate data-animate-delay-{{ animate_delay }}>
                    <div class="button-group">
                      {%- if section.blocks.size == 1 and block.settings.button_link != blank -%}
                        <a class="button button--{{ block.settings.button_size }} mobile:button--small"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                          {{ block.settings.button_label | escape }}
                        </a>
                      {%- else -%}
                        {%- if block.settings.button_label != blank -%}
                          {%- if block.settings.button_style_secondary -%}
                            <a class="button button--cta button--{{ block.settings.button_size }} mobile:button--small"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                              <span class="label">{{ block.settings.button_label | escape }}</span>
                              {% render 'icon', icon: 'arrow' %}
                            </a>
                          {%- else -%}
                            <a class="button button--{{ block.settings.button_size }} mobile:button--small"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                              {{ block.settings.button_label | escape }}
                            </a>
                          {%- endif -%}
                        {%- endif -%}
                        {%- if block.settings.button_alt_label != blank -%}
                          {%- if block.settings.button_alt_style_secondary -%}
                            <a class="button button--cta button--{{ block.settings.button_alt_size }} mobile:button--small"{% if block.settings.button_alt_link != blank %} href="{{ block.settings.button_alt_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                              <span class="label">{{ block.settings.button_alt_label | escape }}</span>
                              {% render 'icon', icon: 'arrow' %}
                            </a>
                          {%- else -%}
                            <a class="button button--secondary button--{{ block.settings.button_alt_size }} mobile:button--small"{% if block.settings.button_alt_link != blank %} href="{{ block.settings.button_alt_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                              {{ block.settings.button_alt_label | escape }}
                            </a>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
      <div class="slideshow__right">
        <div class="slideshow__slide is-selected" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'image' -%}
              {% render 'slide-image', block: block, position: 1, image_behavior: image_behavior %}
            {%- when 'video' -%}
              {% render 'slide-video', block: block, position: 1, image_behavior: image_behavior, section: section %}
          {%- endcase -%}
          {%- if block.settings.stamp_image != blank -%}
            <div class="slideshow__stamp slideshow__stamp--{{ block.settings.stamp_position | default: 'middle-right' }}">
              <img
                src="{{ block.settings.stamp_image | image_url: width: 600 }}"
                alt="{{ block.settings.stamp_image.alt | escape }}"
                style="width: {{ block.settings.stamp_width | default: 188 }}px; --stamp-width: {{ block.settings.stamp_width | default: 188 }}px;"
              >
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="page-width">
      {{ 'onboarding.no_content' | t }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Slideshow - Brand",
  "tag": "section",
  "class": "section",
  "max_blocks": 15,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.slideshow.settings.paragraph.content"
    },
    {
      "type": "select",
      "id": "slideshow_type",
      "options": [
        {
          "value": "modern",
          "label": "t:sections.slideshow.settings.slideshow_type.options__1.label"
        },
        {
          "value": "legacy",
          "label": "t:sections.slideshow.settings.slideshow_type.options__2.label"
        }
      ],
      "default": "modern",
      "label": "t:sections.slideshow.settings.slideshow_type.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.all.text_alignment.label",
      "info": "t:sections.slideshow.settings.text_alignment.info"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "label": "t:sections.slideshow.settings.image_ratio.options__1.label",
          "value": "550px"
        },
        {
          "label": "t:sections.slideshow.settings.image_ratio.options__2.label",
          "value": "650px"
        },
        {
          "label": "t:sections.slideshow.settings.image_ratio.options__3.label",
          "value": "750px"
        },
        {
          "label": "t:sections.slideshow.settings.image_ratio.options__4.label",
          "value": "850px"
        },
        {
          "label": "t:sections.slideshow.settings.image_ratio.options__5.label",
          "value": "900px"
        },
        {
          "label": "t:sections.slideshow.settings.image_ratio.options__6.label",
          "value": "100vh"
        },
        {
          "label": "t:sections.slideshow.settings.image_ratio.options__7.label",
          "value": "adapt_first"

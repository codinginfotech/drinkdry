}
#shopify-section-{{ section.id }} .banner__content .banner__box {
    border: 0;
    padding: 4rem 0;
}
#shopify-section-{{ section.id }} .banner__content .banner__box .button{
  width: auto;
        min-width: inherit;
}
#shopify-section-{{ section.id }} .banner__content .banner__box .button-group
{
  margin-top: 2rem;
}
#shopify-section-{{ section.id }} .brand-box {
            bottom: 17px;
        right: 0;
        padding: 0 16px 0 0;
    }  
   #shopify-section-{{ section.id }} .bottle-image{
      max-height: 100px
   }    

  @media(min-width:1024px){
#shopify-section-{{ section.id }} .banner__box {
        width: 33%;
    }
}
{%- endstyle -%}

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 4680'
  else
    assign half_width = '50vw'
    assign full_width = '100vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
    assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  endif
-%}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full-width{% endif %}">
    <div id="Banner-{{ section.id }}" class="banner{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.show_text_box %} banner--container{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}">
       {% if section.settings.logo_image %}
            <div class="banner-logo page-width">
                <img src="{{ section.settings.logo_image | img_url:'98x98' }}">
            </div>
          {% endif %}
        {% if section.settings.brand_logo and section.settings.p_image %}
            <div class="brand-box page-width">
                <div class="brand-b">
                    <a href="{% if section.settings.brand_link %}{{ section.settings.brand_link }}{% else %}#{% endif %}">
                    <div class="arrow"><svg xmlns="http://www.w3.org/2000/svg" width="27" height="28" viewBox="0 0 27 28" fill="none">
<rect x="0.6875" y="0.851562" width="26" height="27" rx="13" fill="white"/>
<path d="M10.7711 10.9044H17.1351V17.2684M16.6932 11.3463L10.2408 17.7987" stroke="#17416F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div>
                    <img src="{{ section.settings.brand_logo | img_url:'106x50' }}" class="brand-logo">
                    <img src="{{ section.settings.p_image | img_url:'x162' }}" class="bottle-image">
                </a>
                </div>
            </div>
          {% endif %}  
        {%- if section.settings.image != blank -%}
        <div class="banner__media{% if section.settings.image_2 != blank %} banner__media-half{% endif %}">
        
            <use-animate data-animate="zoom-fade" class="media-wrapper">
            <div class="image-animate media media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }}{% if section.settings.image == blank and section.settings.image_2 == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
              {%-liquid
                assign image = section.settings.image
                assign image_class = 'image-fit'
                if section.settings.image_2 != blank
                  assign image_class = image_class | append: ' banner__media-image-half'
                endif
                if section.settings.image_2 != blank and section.settings.stack_images_on_mobile
                  assign sizes = stacked_sizes
                elsif section.settings.image_2 != blank
                  assign sizes = half_width
                else
                  assign sizes = full_width
                endif
              -%}
              <picture class="motion-reduce">
                {%- if section.settings.mobile_image -%}
                  {%- liquid
                    capture srcset_mobile
                      assign _img = section.settings.mobile_image | image_url: width: 3840 | image_tag: sizes: sizes
                      assign _sImg = _img | split: 'srcset="' 
                      assign _sImg = _sImg[1] | split: '"' | first
                      echo _sImg
                    endcapture
                  -%}
                  <source media="(max-width: 749px)" srcset="{{ srcset_mobile }}" sizes="{{ sizes }}">
                {%- endif -%}
                {%- liquid
                  assign loading = 'lazy'
                  assign fetchpriority = 'low'
                  if section.index == 1
                    assign loading = 'eager'
                    assign fetchpriority = 'high'
                  endif
                -%}
                {%- echo image | image_url: width: 3840 | image_tag: loading: loading, class: image_class, sizes: sizes, widths: widths, is: 'lazy-image', fetchpriority: fetchpriority -%}
              </picture>
            </div>
          </use-animate>
        </div>
      {%- elsif section.settings.image_2 == blank -%}
        <div class="banner__media">
          <use-animate data-animate="zoom-fade" class="media media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder image-animate' }}
          </use-animate>
        </div>
      {%- endif -%}
      {%- if section.settings.image_2 != blank -%}
        <div class="banner__media{% if section.settings.image != blank %} banner__media-half{% endif %}">
          <use-animate data-animate="zoom-fade" class="media-wrapper">
            <div class="image-animate media media--{{ section.settings.image_ratio }} media-mobile--{{ section.settings.mobile_image_ratio }}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
              {%-liquid
                assign image_2nd = section.settings.image_2
                assign image_class_2nd = 'image-fit'
                if section.settings.image != blank
                  assign image_class_2nd = image_class_2nd | append: ' banner__media-image-half'
                endif
                if section.settings.image != blank and section.settings.stack_images_on_mobile
                  assign sizes_2nd = stacked_sizes
                elsif section.settings.image != blank
                  assign sizes_2nd = half_width
                else
                  assign sizes_2nd = full_width
                endif
              -%}
              <picture class="motion-reduce">
                {%- if section.settings.mobile_image_2 -%}
                  {%- liquid
                    capture srcset_mobile_2
                      assign _img = section.settings.mobile_image_2 | image_url: width: 3840 | image_tag: sizes: sizes_2nd
                      assign _sImg = _img | split: 'srcset="' 
                      assign _sImg = _sImg[1] | split: '"' | first
                      echo _sImg
                    endcapture
                  -%}
                  <source media="(max-width: 749px)" srcset="{{ srcset_mobile_2 }}" sizes="{{ sizes_2nd }}">
                {%- endif -%}
                {%- echo image_2nd | image_url: width: 3840 | image_tag: loading: 'lazy', class: image_class_2nd, sizes: sizes_2nd, widths: widths, is: 'lazy-image' -%}
              </picture>
            </div>
          </use-animate>
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="banner__content banner__content--{{ section.settings.text_box_position }} page-width">
          
          <div class="banner__box {{ section.settings.text_alignment }} mobile-{{ section.settings.mobile_text_alignment }}">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  <{{ block.settings.heading_tag }} class="banner__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                    {%- render 'highlight-text', 
                        hl_input: block.settings.heading, 
                        hl_style: block.settings.highlight_style,
                        hl_enable: block.settings.enable_highlight,
                        hl_animateWrap: true -%}
                  </{{ block.settings.heading_tag }}>
                {%- when 'subheading' -%}
                  <p class="banner__subheading{% if block.settings.secondary_color %} banner__subheading--colored{% endif %} {{ block.settings.subheading_size }}" {{ block.shopify_attributes }}>
                    {%- render 'highlight-text', 
                        hl_input: block.settings.subheading, 
                        hl_style: block.settings.highlight_style,
                        hl_enable: block.settings.enable_highlight,
                        hl_animateWrap: true -%}
                  </p>
                {%- when 'text' -%}
                  <div class="banner__text{% if block.settings.secondary_color %} banner__text--colored{% endif %} {{ block.settings.text_size }} rte" {{ block.shopify_attributes }}>
                    {%- render 'highlight-text', 
                        hl_input: block.settings.text, 
                        hl_style: block.settings.highlight_style,
                        hl_enable: block.settings.enable_highlight,
                        hl_animateWrap: true -%}
                  </div>
                {%- when 'custom_liquid' -%}
                  <div class="banner__text rte" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
                {%- when 'button' -%}
                  <div class="button-group">
                    {%- if block.settings.button_label != blank or block.settings.button_alt_label != blank -%}
                      {%- if block.settings.button_label != blank -%}
                        {%- if block.settings.button_style_secondary -%}
                          <a class="button button--cta button--{{ block.settings.button_size }}"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
                            <span class="label">{{ block.settings.button_label | escape }}</span>
                            {% render 'icon', icon: 'arrow' %}
                          </a>
                        {%- else -%}
                          <a class="button button--{{ block.settings.button_size }}"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
                            {{ block.settings.button_label | escape }}
                          </a>
                        {%- endif -%}
                      {%- endif -%}
                      {%- if block.settings.button_alt_label != blank -%}
                        {%- if block.settings.button_alt_style_secondary -%}
                          <a class="button button--cta button--{{ block.settings.button_size }}"{% if block.settings.button_alt_link != blank %} href="{{ block.settings.button_alt_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
                            <span class="label">{{ block.settings.button_alt_label | escape }}</span>
                            {% render 'icon', icon: 'arrow' %}
                          </a>
                        {%- else -%}
                          <a class="button button--secondary button--{{ block.settings.button_size }}"{% if block.settings.button_alt_link != blank %} href="{{ block.settings.button_alt_link }}"{% else %} role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
                            {{ block.settings.button_alt_label | escape }}
                          </a>
                        {%- endif -%}
                      {%- endif -%}
                    {%- elsif section.blocks.size == 1 and block.settings.button_link != blank -%}
                      <a class="full-unstyled-link" href="{{ block.settings.button_link }}" {{ block.shopify_attributes }}></a>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>


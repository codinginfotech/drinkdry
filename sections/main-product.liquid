      }
      
      .recharge-checkbox-input:checked + .recharge-checkbox-custom {
        background: {{ block.settings.checkbox_color | default: '#17416F' }};
        border-color: {{ block.settings.checkbox_color | default: '#17416F' }};
      }
      
      .recharge-checkbox-custom svg {
        opacity: 0;
        transition: opacity 0.2s ease;
        color: #ffffff;
        width: 16px;
        height: 16px;
      }
      
      .recharge-checkbox-input:checked + .recharge-checkbox-custom svg {
        opacity: 1;
      }
      
      .recharge-checkbox-label {
        flex: 1;
      }
      
      .recharge-checkbox-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 0;
        flex-wrap: wrap;
      }
      
      .checkbox-title-text {
        font-weight: 500;
        color: #17416F;
        font-size: 15px;
      }
      
      .recharge-savings-badge {
        color: #ffffff;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        position: relative;
        z-index: 1;
        transform: rotate(6deg);
        padding: 6px 12px;
      }
      .recharge-savings-badge:before {
        background-repeat: no-repeat;
        content: "";
        display: block;
        background-image: url(https://cdn.shopify.com/s/files/1/0500/1664/9366/files/Button.svg);
        width: 82px;
        height: 31px;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -1;
        transform: rotate(-5deg);
        background-size: cover;
      }
      .checkbox-subtitle {
        font-size: 14px;
        color: #6b7280;
        line-height: 1.4;
        margin: 0;
      }
      
      .recharge-content-dropdown {
        padding: 20px;
        display: none;
        animation: fadeIn 0.3s ease;
      }
      
      .recharge-content-dropdown.active {
        display: block;
      }
      .recharge-content-dropdown .re-plan{
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
      }
      .recharge-dropdown-label {
        margin-bottom: 0;
        font-weight: 500;
        color: #17416F;
        font-size: 14px;
        min-width:105px;
      }
      
      /* Custom Select Styling */
      .custom-select {
        position: relative;
        width: 100%;

      }
      
      .select-selected {
        padding: 12px 45px 12px 15px;
        border: 1px solid #9BACBE;
        border-radius: 30px;
        background-color: #ffffff;
        color: #17416F;
        cursor: pointer;
        font-family: Montserrat, sans-serif;
        font-weight: 500;
        font-size: 16px;
        transition: all 0.2s ease;
        position: relative;
            display: flex;
    gap: 5px;
    align-items: center;
      }
      .select-items .option-item.active{
      position:relative;
      color:#E64F2A;
    }
      .select-selected:after, .select-items .option-item.active:after {
        content: '';
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        background-image: url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9L12 15L18 9' stroke='%236b7280' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: center;
        transition: transform 0.2s ease;
      }
      
      .select-items {
        position: absolute;
        background-color: #ffffff;
        width: 100%;
        border: 1px solid #9BACBE;
        border-radius: 12px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.1);
        z-index: 99;
        top:0;
        max-height: 300px;
        overflow-y: auto;
      }
      
      .select-items .option-item {
        padding: 12px 15px;
        cursor: pointer;
        color: #17416F;
        font-family: Montserrat, sans-serif;
        font-size: 15px;
        transition: all 0.2s ease;
        border-bottom: 1px solid #f0f0f0;
        background-color: #ffffff;
      }
      
      .select-items .option-item:last-child {
        border-bottom: none;
      }
      
      .select-items .option-item:hover {
        background-color: #f8f8f8;
      }
      
      .select-items .option-item.active {
        background-color: #f0f5fa;
        font-weight: 600;
        display: flex;
        gap: 5px;
      }
      
      .option-text {
        display: block;
        font-weight: 500;
      }
      
      .option-note {
        display: block;
        font-size: 12px;
        color: #17416F;
        font-weight: 400;
        font-style: italic;
        margin-top: 2px;
      }
      
      .select-hide {
        display: none;
      }
      
      .select-selected:hover {
        border-color: #17416F;
      }
      
      .select-selected.select-arrow-active:after {
        transform: translateY(-50%) rotate(180deg);
      }
      
      .recharge-price-comparison {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-top: 15px;
      }
      
      .recharge-price-option {
        padding: 15px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
      }
      
      .recharge-price-option:hover {
        border-color: #9ca3af;
      }
      
      .recharge-price-option.active {
        border-color: #3b82f6;
        background: #f0f9ff;
      }
      
      .recharge-price-type {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 5px;
      }
      
      .recharge-price-amount {
        font-size: 20px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 5px;
      }
      
      .recharge-price-savings {
        font-size: 13px;
        background: #d1fae5;
        color: #065f46;
        padding: 3px 8px;
        border-radius: 12px;
        display: inline-block;
        font-weight: 600;
      }
      
      .recharge-description-dropdown {
        font-size: 13px;
        color: #17416F;
        line-height: 1.5;
        margin-top: 15px;
        padding-top: 15px;
      }
      
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(-5px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      @media (max-width: 768px) {
        .recharge-toggle-section,
        .recharge-content-dropdown {
          padding: 16px 18px;
        }
        
        .recharge-content-dropdown .re-plan {
          flex-direction: column;
          align-items: flex-start;
          gap: 10px;
        }
        
        .recharge-dropdown-label {
          min-width: auto;
        }
        
        .custom-select {
          max-width: 100%;
          width: 100%;
        }
        
        .recharge-price-comparison {
          grid-template-columns: 1fr;
          gap: 10px;
        }
        
        .recharge-price-option {
          padding: 12px;
        }
      }
    </style>
    
    <!-- Checkbox Toggle Section -->
    <div class="recharge-toggle-section">
      <label class="recharge-checkbox-container">
        <input type="checkbox" 
               class="recharge-checkbox-input" 
               id="RechargeCheckbox-{{ section.id }}"
               name="recharge_subscription"
               {% if block.settings.checked_by_default %}checked{% endif %}>
        
        <span class="recharge-checkbox-custom">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        
        <div class="recharge-checkbox-label">
          <div class="recharge-checkbox-title">
            <span class="checkbox-title-text">
              {{ block.settings.checkbox_label | default: 'Subscribe & Save' }}
            </span>
            {% if block.settings.badge_text %}
              <span class="recharge-savings-badge">
                {{ block.settings.badge_text | default: 'Save 10%' }}
              </span>
            {% endif %}
          </div>
          {% if block.settings.checkbox_subtitle %}
            <p class="checkbox-subtitle">{{ block.settings.checkbox_subtitle }}</p>
          {% endif %}
        </div>
      </label>
    </div>
    
    <!-- Dropdown Content (Shows when checkbox is checked) -->
    <div class="recharge-content-dropdown" id="RechargeDropdownContent-{{ section.id }}">
      <div class="re-plan">
        <label class="recharge-dropdown-label" for="RechargeFrequencySelect-{{ section.id }}">
          {{ block.settings.dropdown_label | default: 'Deliver every:' }}
        </label>
        
        <!-- Custom Select Dropdown -->
        <div class="custom-select" id="RechargeCustomSelect-{{ section.id }}">
          <div class="select-selected" id="RechargeSelectSelected-{{ section.id }}">
            {% assign first_plan = product.selling_plan_groups.first.selling_plans.first %}
            {% assign is_common = false %}
            {% if first_plan.name contains '2' or first_plan.name contains 'two' or first_plan.name contains 'month' and first_plan.name contains '2' %}
              {% assign is_common = true %}
            {% endif %}
            <span class="option-text">{{ first_plan.name }}</span>
            {% if is_common %}
              <span class="option-note">(most common)</span>
            {% endif %}
          </div>
          <div class="select-items select-hide" id="RechargeSelectItems-{{ section.id }}">
            {% for group in product.selling_plan_groups %}
              {% for plan in group.selling_plans %}
                {% assign discount = 0 %}
                {% assign is_common = false %}
                
                {% if plan.name contains '2' or plan.name contains 'two' or plan.name contains 'month' and plan.name contains '2' %}
                  {% assign is_common = true %}
                {% endif %}
                
                {% for price_adjustment in plan.price_adjustments %}
                  {% if price_adjustment.value < 0 %}
                    {% assign discount = price_adjustment.value | abs %}
                  {% endif %}
                {% endfor %}
                
                <div class="option-item" 
                     data-value="{{ plan.id }}" 
                     data-discount="{{ discount }}"
                     data-frequency="{{ plan.name }}"
                     data-common="{{ is_common }}">
                  <span class="option-text">{{ plan.name }}</span>
                  {% if is_common %}
                      <span class="option-note">(most common)</span>
                  {% endif %}
                  {% if discount > 0 %}
                    <br><span class="option-note" style="color: #065f46; font-style: normal;">Save {{ discount }}%</span>
                  {% endif %}
                </div>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
        
        <!-- Hidden select for form submission -->
        <select class="recharge-dropdown-select hidden-select" 
                id="RechargeFrequencySelect-{{ section.id }}"
                data-product-id="{{ product.id }}"
                style="display: none;">
          {% for group in product.selling_plan_groups %}
            {% for plan in group.selling_plans %}
              {% assign discount = 0 %}
              {% for price_adjustment in plan.price_adjustments %}
                {% if price_adjustment.value < 0 %}
                  {% assign discount = price_adjustment.value | abs %}
                {% endif %}
              {% endfor %}
              
              <option value="{{ plan.id }}" 
                      data-discount="{{ discount }}"
                      data-frequency="{{ plan.name }}"
                      {% if forloop.first %}selected{% endif %}>
                {{ plan.name }}
              </option>
            {% endfor %}
          {% endfor %}
        </select>
      </div>
      
      <!-- Price Comparison -->
      {% if block.settings.show_price_comparison %}
        <div class="recharge-price-comparison">
          <!-- One-time Purchase -->
          <div class="recharge-price-option active" 
               id="OneTimeOption-{{ section.id }}"
               onclick="selectOneTimePurchase()">
            <div class="recharge-price-type">One-time purchase</div>
            <div class="recharge-price-amount" id="OneTimePriceDisplay-{{ section.id }}">
              {{ product.selected_or_first_available_variant.price | money }}
            </div>
          </div>
          
          <!-- Subscription Option -->
          <div class="recharge-price-option" 
               id="SubscriptionOption-{{ section.id }}"
               onclick="selectSubscription()">
            <div class="recharge-price-type">Subscribe & Save</div>
            <div class="recharge-price-amount" id="SubscriptionPriceDisplay-{{ section.id }}">
              {% assign first_plan = product.selling_plan_groups.first.selling_plans.first %}
              {% assign discount = 0 %}
              {% for price_adjustment in first_plan.price_adjustments %}
                {% if price_adjustment.value < 0 %}
                  {% assign discount = price_adjustment.value | abs %}
                {% endif %}
              {% endfor %}
              
              {% if discount > 0 %}
                {% assign subscription_price = product.selected_or_first_available_variant.price 
                     | times: 1 
                     | minus: product.selected_or_first_available_variant.price 
                     | times: discount 
                     | divided_by: 100 
                     | money %}
                {{ subscription_price }}
              {% else %}
                {{ product.selected_or_first_available_variant.price | money }}
              {% endif %}
            </div>
            <div class="recharge-price-savings" id="SavingsDisplay-{{ section.id }}">
              {% if discount > 0 %}
                Save {{ discount }}%
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
      
      {% if block.settings.description %}
        <div class="recharge-description-dropdown">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
    
    <!-- Hidden Input for Selling Plan -->
    <input type="hidden" 
           name="selling_plan" 
           id="RechargeSellingPlanInput-{{ section.id }}"
           value="{% if block.settings.checked_by_default %}{% for group in product.selling_plan_groups %}{% for plan in group.selling_plans %}{% if forloop.first %}{{ plan.id }}{% endif %}{% endfor %}{% endfor %}{% endif %}">
    
    <!-- JavaScript -->
    <script>
    (function() {
      'use strict';
      
      const CONFIG = {
        sectionId: '{{ section.id }}',
        productId: '{{ product.id }}',
        variantId: {{ product.selected_or_first_available_variant.id }},
        variantPrice: {{ product.selected_or_first_available_variant.price }}
      };
      
      // Elements
      const elements = {
        checkbox: document.getElementById(`RechargeCheckbox-${CONFIG.sectionId}`),
        dropdownContent: document.getElementById(`RechargeDropdownContent-${CONFIG.sectionId}`),
        customSelect: document.getElementById(`RechargeCustomSelect-${CONFIG.sectionId}`),
        selectSelected: document.getElementById(`RechargeSelectSelected-${CONFIG.sectionId}`),
        selectItems: document.getElementById(`RechargeSelectItems-${CONFIG.sectionId}`),
        hiddenSelect: document.getElementById(`RechargeFrequencySelect-${CONFIG.sectionId}`),
        sellingPlanInput: document.getElementById(`RechargeSellingPlanInput-${CONFIG.sectionId}`),
        oneTimeOption: document.getElementById(`OneTimeOption-${CONFIG.sectionId}`),
        subscriptionOption: document.getElementById(`SubscriptionOption-${CONFIG.sectionId}`),
        oneTimePrice: document.getElementById(`OneTimePriceDisplay-${CONFIG.sectionId}`),
        subscriptionPrice: document.getElementById(`SubscriptionPriceDisplay-${CONFIG.sectionId}`),
        savingsDisplay: document.getElementById(`SavingsDisplay-${CONFIG.sectionId}`)
      };
      
      // State
      let state = {
        isSubscription: elements.checkbox.checked,
        selectedPlanId: elements.hiddenSelect ? elements.hiddenSelect.value : '',
        selectedDiscount: elements.hiddenSelect ? parseInt(elements.hiddenSelect.selectedOptions[0]?.dataset.discount || 0) : 0
      };
      
      // Initialize custom select functionality
      function initCustomSelect() {
        if (!elements.customSelect || !elements.selectSelected || !elements.selectItems) return;
        
        // Toggle visibility of the options list on button click
        elements.selectSelected.addEventListener("click", function (e) {
          e.stopPropagation();
          elements.selectItems.classList.toggle("select-hide");
          this.classList.toggle("select-arrow-active");
        });
        
        // Add click listeners to each option item
        const optionItems = elements.selectItems.querySelectorAll(".option-item");
        optionItems.forEach(item => {
          item.addEventListener("click", function (e) {
            e.stopPropagation();
            
            // Remove active class from all options
            optionItems.forEach(opt => opt.classList.remove("active"));
            
            // Add active class to selected option
            this.classList.add("active");
            
            // Update the selected display
            elements.selectSelected.innerHTML = this.innerHTML;
            
            // Update hidden select value
            const selectedValue = this.getAttribute("data-value");
            if (elements.hiddenSelect) {
              elements.hiddenSelect.value = selectedValue;
              elements.hiddenSelect.dispatchEvent(new Event('change'));
            }
            
            // Update state
            state.selectedPlanId = selectedValue;
            state.selectedDiscount = parseInt(this.getAttribute("data-discount") || 0);
            
            // Update form integration
            updateFormIntegration();
            
            // Hide the options list
            elements.selectItems.classList.add("select-hide");
            elements.selectSelected.classList.remove("select-arrow-active");
            
            // Update subscription price display
            if (state.isSubscription) {
              updateSubscriptionPriceDisplay();
            }
          });
        });
        
        // Close the dropdown if the user clicks outside of it
        document.addEventListener("click", function (e) {
          if (elements.customSelect && !elements.customSelect.contains(e.target)) {
            elements.selectItems.classList.add("select-hide");
            elements.selectSelected.classList.remove("select-arrow-active");
          }
        });
      }
      
      // Initialize
      function init() {
        setupEventListeners();
        initCustomSelect();
        updateUI();
        updateFormIntegration();
        
        // If checkbox is checked by default, show dropdown
        if (state.isSubscription) {
          updateSubscriptionPriceDisplay();
        }
        
        console.log('Recharge dropdown widget initialized', { CONFIG, state });
      }
      
      // Setup event listeners
      function setupEventListeners() {
        // Checkbox toggle
        if (elements.checkbox) {
          elements.checkbox.addEventListener('change', handleCheckboxChange);
        }
        
        // Listen for variant changes
        document.addEventListener('variant:change', handleVariantChange);
        
        // Listen for changes on hidden select (in case other code updates it)
        if (elements.hiddenSelect) {
          elements.hiddenSelect.addEventListener('change', handleSelectChange);
        }
      }
      
      // Handle checkbox change
      function handleCheckboxChange(e) {
        state.isSubscription = e.target.checked;
        updateUI();
        updateFormIntegration();
        updateButtonText();
        
        if (state.isSubscription) {
          updateSubscriptionPriceDisplay();
        }
      }
      
      // Handle select change
      function handleSelectChange(e) {
        const selectedOption = e.target.selectedOptions[0];
        state.selectedPlanId = e.target.value;
        state.selectedDiscount = parseInt(selectedOption?.dataset.discount || 0);
        
        // Update custom select display if needed
        if (elements.selectItems) {
          const optionItems = elements.selectItems.querySelectorAll(".option-item");
          optionItems.forEach(item => {
            item.classList.remove("active");
            if (item.getAttribute("data-value") === e.target.value) {
              item.classList.add("active");
              elements.selectSelected.innerHTML = item.innerHTML;
            }
          });
        }
        
        updateSubscriptionPriceDisplay();
        updateFormIntegration();
      }
      
      // Handle variant change
      function handleVariantChange(event) {
        const variant = event.detail;
        if (!variant || !variant.id) return;
        
        // Update current variant ID and price
        CONFIG.variantId = variant.id;
        CONFIG.variantPrice = variant.price;
        
        // Update price displays
        updatePriceDisplays(variant.price);
        
        // Check if new variant has subscriptions
        const hasSubscriptions = variant.selling_plan_allocations && 
                                variant.selling_plan_allocations.length > 0;
        
        if (!hasSubscriptions && state.isSubscription) {
          // If variant doesn't support subscriptions, uncheck the checkbox
          elements.checkbox.checked = false;
          state.isSubscription = false;
          updateUI();
        }
        
        updateFormIntegration();
      }
      
      // Update UI based on state
      function updateUI() {
        // Show/hide dropdown content
        if (elements.dropdownContent) {
          elements.dropdownContent.classList.toggle('active', state.isSubscription);
        }
        
        // Update price option highlights
        if (elements.oneTimeOption && elements.subscriptionOption) {
          elements.oneTimeOption.classList.toggle('active', !state.isSubscription);
          elements.subscriptionOption.classList.toggle('active', state.isSubscription);
        }
      }
      
      // Update price displays
      function updatePriceDisplays(variantPrice) {
        // Update one-time price
        if (elements.oneTimePrice) {
          elements.oneTimePrice.textContent = formatMoney(variantPrice);
        }
        
        // Update subscription price if checkbox is checked
        if (state.isSubscription && elements.subscriptionPrice) {
          updateSubscriptionPriceDisplay(variantPrice);
        }
      }
      
      // Update subscription price display
      function updateSubscriptionPriceDisplay(variantPrice = CONFIG.variantPrice) {
        if (!elements.hiddenSelect || !elements.subscriptionPrice || !elements.savingsDisplay) return;
        
        const selectedOption = elements.hiddenSelect.selectedOptions[0];
        const discount = state.selectedDiscount || parseInt(selectedOption?.dataset.discount || 0);
        
        if (discount > 0) {
          const discountAmount = variantPrice * discount / 100;
          const subscriptionPrice = variantPrice - discountAmount;
          
          elements.subscriptionPrice.textContent = formatMoney(subscriptionPrice);
          elements.savingsDisplay.textContent = `Save ${discount}%`;
          elements.savingsDisplay.style.display = 'inline-block';
        } else {
          elements.subscriptionPrice.textContent = formatMoney(variantPrice);
          elements.savingsDisplay.style.display = 'none';
        }
      }
      
      // Update all forms with selling_plan
      function updateFormIntegration() {
        const sellingPlanValue = state.isSubscription ? state.selectedPlanId : '';
        
        // Update hidden input
        if (elements.sellingPlanInput) {
          elements.sellingPlanInput.value = sellingPlanValue;
        }
        
        // Update ALL product forms on the page
        document.querySelectorAll('form[action*="/cart/add"]').forEach(form => {
          updateFormSellingPlan(form, sellingPlanValue);
        });
        
        console.log('Form integration updated:', {
          isSubscription: state.isSubscription,
          sellingPlan: sellingPlanValue || 'none'
        });
      }
      
      // Update individual form with selling_plan
      function updateFormSellingPlan(form, sellingPlanId) {
        // Remove existing selling_plan inputs (except our main one)
        form.querySelectorAll('input[name="selling_plan"]').forEach(input => {
          if (input.id !== `RechargeSellingPlanInput-${CONFIG.sectionId}`) {
            input.remove();
          }
        });
        
        // Add selling_plan to form if needed
        if (sellingPlanId) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'selling_plan';
          input.value = sellingPlanId;
          form.appendChild(input);
        }
      }
      
      // Update button text
      function updateButtonText() {
        const buttons = document.querySelectorAll('[name="add"], .product-form__submit, button[type="submit"]');
        buttons.forEach(button => {
          if (state.isSubscription) {
            button.textContent = 'Subscribe';
            button.classList.add('subscription-active');
          } else {
            button.textContent = 'Add to cart';
            button.classList.remove('subscription-active');
          }
        });
      }
      
      // Format money
      function formatMoney(cents) {
        return Shopify.formatMoney(cents, '{{ shop.money_format }}');
      }
      
      // Hook into form submission for better integration
      function setupFormSubmissionHooks() {
        document.querySelectorAll('form[action*="/cart/add"]').forEach(form => {
          form.addEventListener('submit', function(e) {
            // Double-check selling_plan is included
            if (state.isSubscription && !state.selectedPlanId) {
              e.preventDefault();
              alert('Please select a delivery frequency for your subscription');
              return false;
            }
          });
        });
        
        // Hook into AJAX cart if used
        if (window.Shopify && Shopify.addItemFromForm) {
          const originalAddItem = Shopify.addItemFromForm;
          Shopify.addItemFromForm = function(form, callback, errorCallback) {
            // Ensure selling_plan is in form data
            if (state.isSubscription && state.selectedPlanId) {
              const formData = new FormData(form);
              if (!formData.has('selling_plan')) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selling_plan';
                input.value = state.selectedPlanId;
                form.appendChild(input);
              }
            }
            return originalAddItem.call(this, form, callback, errorCallback);
          };
        }
      }
      
      // Global functions for onclick handlers
      window.selectOneTimePurchase = function() {
        if (elements.checkbox) {
          elements.checkbox.checked = false;
          state.isSubscription = false;
          updateUI();
          updateFormIntegration();
          updateButtonText();
        }
      };
      
      window.selectSubscription = function() {
        if (elements.checkbox) {
          elements.checkbox.checked = true;
          state.isSubscription = true;
          updateUI();
          updateFormIntegration();
          updateButtonText();
          updateSubscriptionPriceDisplay();
        }
      };
      
      // Initialize when ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      
      // Setup form hooks
      setupFormSubmissionHooks();
      
    })();
    </script>
  </div>
{%- endif -%}



<script src="//ajax.googleapis.com/ajax/libs/jquery/1.10.1/jquery.min.js"></script>
<script>
$(document).ready(function () {

  /* ---------- Shipping / delivery messaging (Dubai timezone) ---------- */
  var options = {
    timeZone: 'Asia/Dubai',
    hour: 'numeric',
    minute: 'numeric',
    hourCycle: 'h23'
  };
  var formatter      = new Intl.DateTimeFormat([], options);
  var dubai_time     = formatter.format(new Date());
  var dubai_hour     = parseInt(dubai_time.split(":")[0], 10);

  if (dubai_hour > 0 && dubai_hour < 11) {
    $("#shipping_time_2").html(
      "<ul style='margin:0'>" +
        "<li><b>Same day</b> delivery in Dubai if order placed before 6pm (daily)</li>" +
        "<li>Next Day Delivery to Abu Dhabi if placed before 5pm Except Public Holidays.</li>" +
        "<li>Weekly schedule for the Other Emirates. Except Public Holidays. (excluding remote areas)</li>" +
      "</ul>"
    );
  } else {
    $("#shipping_time_2").html(
      "<ul style='margin:0'>" +
        "<li><b>Dubai:</b> Same Day Delivery Daily if order placed before 6pm</li>" +
        "<li><b>Other Emirates:</b> 48 UP TO 72 Hours Delivery (within City Limits)</li>" +
        "<li>Excluding remote areas</li>" +
      "</ul>"
    );
  }

  /* Remove stray legacy nodes if present */
  $('#show-less, #show-more').remove();

  /* ---------- Read more / less for the product description ---------- */
  function AddReadMore() {
    var charLimit   = 200;
    var readMoreTxt = "Read more +";
    var readLessTxt = "Read less -";

    // Collapse a block to a SAFE plain-text preview (never cuts HTML mid-tag)
    function collapse($el) {
      var fullText = $("<div>").html($el.data("rm-full")).text();
      var preview  = $.trim(fullText.substring(0, charLimit)) + "... ";

      $el.removeClass("show-more-content").addClass("show-less-content");
      $el.empty().text(preview);
      $el.append('<span class="read-more" title="Click to Show More">' + readMoreTxt + '</span>');
    }

    // Expand a block back to its ORIGINAL full HTML (formatting intact)
    function expand($el) {
      $el.removeClass("show-less-content").addClass("show-more-content");
      $el.html($el.data("rm-full"));
      $el.append('<span class="read-less" title="Click to Show Less">' + readLessTxt + '</span>');
    }

    $(".add-read-more").each(function () {
      var $el = $(this);
      if ($el.data("rm-init")) return;       // don't process twice

      $el.data("rm-full", $el.html());       // remember THIS element's own HTML
      $el.data("rm-init", true);

      if ($el.text().length > charLimit) {
        collapse($el);
      }
    });

    $(document)
      .off("click.readmore")
      .on("click.readmore", ".read-more", function () {
        expand($(this).closest(".add-read-more"));
      })
      .on("click.readmore", ".read-less", function () {
        collapse($(this).closest(".add-read-more"));
      });
  }
  AddReadMore();

  /* ---------- Product info tabs ---------- */
  $('.tab-a').on('click', function () {
    var id = $(this).attr('data-id');
    $(".tab").removeClass('tab-active');
    $(".tab[data-id='" + id + "']").addClass("tab-active");
    $(".tab-a").removeClass('active-a');
    $(this).parent().find(".tab-a").removeClass('active-a');
    $(this).addClass('active-a');
  });

});
</script>


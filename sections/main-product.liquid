<script>
document.addEventListener('DOMContentLoaded', function() {
  // Log all form submissions
  document.querySelectorAll('form[action*="/cart/add"]').forEach(form => {
    form.addEventListener('submit', function(e) {
      console.group('Cart Form Submission');
      console.log('Form action:', this.action);
      
      // Get all form data
      const formData = new FormData(this);
      for (let [key, value] of formData.entries()) {
        console.log(key + ':', value);
      }
      
      // Check for subscription
      const sellingPlan = formData.get('selling_plan');
      if (sellingPlan) {
        console.log('✅ Subscription detected! Selling Plan:', sellingPlan);
      } else {
        console.log('❌ No subscription plan found');
      }
      console.groupEnd();
    });
  });
  
  // Check AJAX cart if used
  if (typeof Shopify === 'object' && Shopify.addItemFromForm) {
    const originalAddItem = Shopify.addItemFromForm;
    Shopify.addItemFromForm = function(form, callback, errorCallback) {
      console.log('AJAX Cart Submission via Shopify.addItemFromForm');
      const formData = new FormData(form);
      console.log('Selling Plan:', formData.get('selling_plan'));
      return originalAddItem.call(this, form, callback, errorCallback);
    };
  }
});

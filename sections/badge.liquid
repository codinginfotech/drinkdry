{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
     padding-bottom: {{ section.settings.padding_bottom }}px;
     overflow:visible;
  }

.badge-box{
  display:flex;
  justify-content: right;
  gap:20px;
  position:relative;
}
.badge-box .txt{
  font-size:23px;
  font-family: Playfair Display, serif;
    font-style: italic;
    padding:16px 0;
    margin-right:175px;
}
.badge-box .bdg-img{
  position:absolute;
  right:0;
  top:50%;
  transform:translateY(-50%);
}
@media(max-width:749px){
  .badge-box {
    justify-content: left;
}
.badge-box .txt {
    margin-right: 39%;
}
}
{%- endstyle -%} 
 <div class="badgee" {% if section.settings.bg_color != blank %}style="background-color:{{ section.settings.bg_color }}" {% endif %}>
          <div class="page-width">
          <div class="badge-box">  
          {% if section.settings.text %}<div class="txt">{{ section.settings.text }}</div>{% endif %}
            {% if section.settings.img %}<div class="bdg-img"><img src="{{ section.settings.img | img_url:'148x148' }}"></div>{% endif %}
            </div>
          </div>
         </div>


 {% schema %}
{
  "name": "t:sections.badge.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "t:sections.all.bg_color.label"
       },
        {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:sections.all.text.label"
       },
       {
      "type": "image_picker",
      "id": "img",
      "label": "t:sections.all.image.label"
       },
    {
      "type": "header",
      "content": "t:sections.all.padding.header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "t:sections.all.padding.padding_top.unit",
      "label": "t:sections.all.padding.padding_top.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "t:sections.all.padding.padding_bottom.unit",
      "label": "t:sections.all.padding.padding_bottom.label",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.badge.name"
      
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  }
  
 
}
{% endschema %}
        
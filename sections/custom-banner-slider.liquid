    margin-top: 10px;
    }
  @keyframes progress {
    from { width: 0; }
    to { width: 100%; }
  }

  /* Mobile Styles */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .slide__content{
      justify-content: flex-start;
    align-items: flex-start;
    padding-top: 115px;
    }
    #shopify-section-{{ section.id }} .slide__media {
      height: {{ section.settings.mobile_image_ratio }};
    }

    #shopify-section-{{ section.id }} .slide__logo {

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<div class="section--padding{% if section.settings.show_divider %} section--divider{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full-width{% endif %}">
    
    {%- comment -%} Group blocks by slide {%- endcomment -%}
    {%- liquid
      assign slides = section.blocks | where: "type", "slide"
      assign slide_count = slides.size
    -%}

    {%- if slide_count > 0 -%}
      <div class="slider-container" id="slider-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-autoplay-speed="{{ section.settings.autoplay_speed }}000">
        <div class="slider-wrapper">
          {%- for slide in slides -%}
            <div class="slide" data-slide-index="{{ forloop.index0 }}">
              
              {%- comment -%} Slide Background Image {%- endcomment -%}
              <div class="slide__media">
                {%- if slide.settings.image != blank -%}
                  <picture>
                    {%- if slide.settings.mobile_image != blank -%}
                      <source media="(max-width: 749px)" srcset="{{ slide.settings.mobile_image | image_url: width: 750 }} 750w, {{ slide.settings.mobile_image | image_url: width: 1500 }} 1500w">
                    {%- endif -%}
                    {{ slide.settings.image | image_url: width: 3840 | image_tag: 
                      loading: 'lazy', 
                      class: 'slide__image', 
                      sizes: '100vw',
                      widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                    }}
                  </picture>
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder slide__image' }}
                {%- endif -%}
              </div>

              {%- comment -%} Logo {%- endcomment -%}
              {%- if slide.settings.logo_image != blank -%}
                <div class="slide__logo page-width">
                  <img src="{{ slide.settings.logo_image | image_url: width: 200 }}" alt="{{ slide.settings.logo_image.alt | escape }}" loading="lazy">
                </div>
              {%- endif -%}

              {%- comment -%} Brand Box {%- endcomment -%}
              {%- if slide.settings.brand_logo != blank and slide.settings.brand_product_image != blank -%}
                <div class="slide__brand-box page-width">
                  <a href="{{ slide.settings.brand_link | default: '#' }}" class="slide__brand-link">
                    <div class="slide__brand-arrow">
                      <svg xmlns="http://www.w3.org/2000/svg" width="27" height="28" viewBox="0 0 27 28" fill="none">
                        <rect x="0.6875" y="0.851562" width="26" height="27" rx="13" fill="white"/>
                        <path d="M10.7711 10.9044H17.1351V17.2684M16.6932 11.3463L10.2408 17.7987" stroke="#17416F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                    <img src="{{ slide.settings.brand_logo | image_url: width: 200 }}" alt="{{ slide.settings.brand_logo.alt | escape }}" class="slide__brand-logo" loading="lazy">
                    <img src="{{ slide.settings.brand_product_image | image_url: height: 300 }}" alt="{{ slide.settings.brand_product_image.alt | escape }}" class="slide__brand-product" loading="lazy">
                  </a>
                </div>
              {%- endif -%}

              {%- comment -%} Content Box {%- endcomment -%}
              <div class="slide__content slide__content--{{ slide.settings.content_position }}">
                <div class="slide__box text-{{ slide.settings.text_alignment }}{% if slide.settings.show_text_box %} slide__box--with-background{% endif %}">
                  
                  {%- if slide.settings.subheading != blank -%}
                    <p class="slide__subheading {{ slide.settings.subheading_size }}">
                      {{ slide.settings.subheading }}
                    </p>
                  {%- endif -%}

                  {%- if slide.settings.heading != blank -%}
                    <{{ slide.settings.heading_tag }} class="slide__heading {{ slide.settings.heading_size }}">
                      {{ slide.settings.heading }}
                    </{{ slide.settings.heading_tag }}>
                  {%- endif -%}

                  {%- if slide.settings.text != blank -%}
                    <div class="slide__text {{ slide.settings.text_size }} rte">
                      {{ slide.settings.text }}
                    </div>
                  {%- endif -%}

                  {%- if slide.settings.button_label != blank or slide.settings.button_alt_label != blank -%}
                    <div class="slide__button-group">
                      {%- if slide.settings.button_label != blank -%}
                        <a href="{{ slide.settings.button_link }}" class="button button--{{ slide.settings.button_size }}{% if slide.settings.button_style_secondary %} button--secondary{% endif %}">
                          {{ slide.settings.button_label | escape }}
                        </a>
                      {%- endif -%}
                      {%- if slide.settings.button_alt_label != blank -%}
                        <a href="{{ slide.settings.button_alt_link }}" class="button button--{{ slide.settings.button_size }}{% if slide.settings.button_alt_style_secondary %} button--secondary{% else %} button--outline{% endif %}">
                          {{ slide.settings.button_alt_label | escape }}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                </div>
              </div>

            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Navigation Arrows {%- endcomment -%}
        {%- if section.settings.show_arrows and slide_count > 1 -%}
          <button class="slider-nav slider-nav--prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="slider-nav slider-nav--next" aria-label="{{ 'accessibility.next_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {%- endif -%}

        {%- comment -%} Pagination Dots {%- endcomment -%}
        {%- if section.settings.show_pagination and slide_count > 1 -%}
          <div class="slider-pagination">
            {%- for slide in slides -%}
              <button class="slider-dot{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="{{ 'accessibility.go_to_slide' | t }} {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Autoplay Progress Bar {%- endcomment -%}
        {%- if section.settings.autoplay and section.settings.show_progress -%}
          <div class="slider-progress"></div>
        {%- endif -%}

      </div>
    {%- else -%}
      {%- comment -%} No slides - show placeholder {%- endcomment -%}
      <div class="slider-container">
        <div class="slide">
          <div class="slide__media">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder slide__image' }}
          </div>
          <div class="slide__content slide__content--middle-center">
            <div class="slide__box text-center">
              <h2 class="slide__heading h1">{{ 'sections.image_banner.heading' | t }}</h2>
              <p class="slide__text typeset2">{{ 'sections.image_banner.description' | t }}</p>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('slider-{{ section.id }}');
    if (!slider) return;

    const wrapper = slider.querySelector('.slider-wrapper');
    const slides = slider.querySelectorAll('.slide');
    const prevBtn = slider.querySelector('.slider-nav--prev');
    const nextBtn = slider.querySelector('.slider-nav--next');
    const dots = slider.querySelectorAll('.slider-dot');
    const progressBar = slider.querySelector('.slider-progress');
    
    let currentSlide = 0;
    const totalSlides = slides.length;
    const autoplay = slider.dataset.autoplay === 'true';
    const autoplaySpeed = parseInt(slider.dataset.autoplaySpeed) || 5000;
    let autoplayInterval = null;
    let isPaused = false;

    function goToSlide(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      
      currentSlide = index;
      wrapper.style.transform = `translateX(-${currentSlide * 100}%)`;
      
      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentSlide);
      });

      // Reset progress bar
      if (progressBar) {
        progressBar.classList.remove('animating');
        void progressBar.offsetWidth; // Trigger reflow
        if (autoplay && !isPaused) {
          progressBar.classList.add('animating');
        }
      }
    }

    function nextSlide() {
      goToSlide(currentSlide + 1);
    }

    function prevSlide() {
      goToSlide(currentSlide - 1);
    }

    function startAutoplay() {
      if (autoplay && totalSlides > 1) {
        stopAutoplay();
        autoplayInterval = setInterval(nextSlide, autoplaySpeed);
        if (progressBar) {
          progressBar.classList.add('animating');
        }
      }
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
      if (progressBar) {
        progressBar.classList.remove('animating');
      }
    }

    // Event Listeners
    if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); startAutoplay(); });
    
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => { goToSlide(index); startAutoplay(); });
    });

    // Pause on hover
    slider.addEventListener('mouseenter', () => {
      isPaused = true;
      stopAutoplay();
    });

    slider.addEventListener('mouseleave', () => {
      isPaused = false;
      startAutoplay();
    });

    // Touch/Swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
        startAutoplay();
      }
    }

    // Keyboard navigation
    slider.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { prevSlide(); startAutoplay(); }
      if (e.key === 'ArrowRight') { nextSlide(); startAutoplay(); }
    });

    // Initialize
    startAutoplay();
  });
</script>

{% schema %}
{
  "name": "Custom Banner Slider",
  "tag": "section",
  "class": "section custom-image-slider",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "Enable autoplay"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "default": true,
      "label": "Show navigation arrows"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "default": true,
      "label": "Show pagination dots"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "default": true,
      "label": "Show autoplay progress bar"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        { "value": "20% 0", "label": "Top left" },
        { "value": "top center", "label": "Top center" },
        { "value": "80% 0", "label": "Top right" },
        { "value": "20% 50%", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "80% 50%", "label": "Middle right" },
        { "value": "20% 100%", "label": "Bottom left" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "80% 100%", "label": "Bottom right" }
      ],
      "default": "center center",
      "label": "Desktop image position"
    },
    {
      "type": "select",

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --color-overlay-opacity: {{ section.settings.colors_overlay_opacity | divided_by: 100.0 }};
    --color-overlay: {{ section.settings.colors_overlay.red }}, {{ section.settings.colors_overlay.green }}, {{ section.settings.colors_overlay.blue }};
    --color-foreground: {{ section.settings.colors_text.red }}, {{ section.settings.colors_text.green }}, {{ section.settings.colors_text.blue }};
    --color-link: var(--color-foreground);
    --color-border: var(--color-foreground);
    --color-heading: var(--color-foreground);
    --color-button-background: {{ section.settings.colors_button_background.red }}, {{ section.settings.colors_button_background.green }}, {{ section.settings.colors_button_background.blue }};
    --color-button-text: {{ section.settings.colors_button_label.red }}, {{ section.settings.colors_button_label.green }}, {{ section.settings.colors_button_label.blue }};
    --color-button-border: var(--color-button-background);
    --color-shadow: var(--color-foreground);
    --shadow-opacity: 0.3;
    --color-highlight: {{ section.settings.colors_highlight.red }}, {{ section.settings.colors_highlight.green }}, {{ section.settings.colors_highlight.blue }};
    --autoplay-speed: {{ section.settings.autoplay_speed }}s;
  }

  /* Slider Container */
  #shopify-section-{{ section.id }} .slider-container {
    position: relative;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .slider-wrapper {
    display: flex;
    transition: transform 0.5s ease-in-out;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .slide {
    min-width: 100%;
    position: relative;
    /*flex-shrink: 0;*/
  }

  /* Slide Content Positioning */
  #shopify-section-{{ section.id }} .slide__content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .slide__content--top-left { justify-content: flex-start; align-items: flex-start; }
  #shopify-section-{{ section.id }} .slide__content--top-center { justify-content: flex-start; align-items: center; }
  #shopify-section-{{ section.id }} .slide__content--top-right { justify-content: flex-start; align-items: flex-end; }
  #shopify-section-{{ section.id }} .slide__content--middle-left { justify-content: center; align-items: flex-start; }
  #shopify-section-{{ section.id }} .slide__content--middle-center { justify-content: center; align-items: center; }
  #shopify-section-{{ section.id }} .slide__content--middle-right { justify-content: center; align-items: flex-end; }
  #shopify-section-{{ section.id }} .slide__content--bottom-left { justify-content: flex-end; align-items: flex-start; }
  #shopify-section-{{ section.id }} .slide__content--bottom-center { justify-content: flex-end; align-items: center; }
  #shopify-section-{{ section.id }} .slide__content--bottom-right { justify-content: flex-end; align-items: flex-end; }

  /* Logo Positioning */
  #shopify-section-{{ section.id }} .slide__logo {
    position: absolute;
    top: 6%;
    left: auto;
    width: 100%;
    right: auto;
    padding: 0 8rem;
    z-index: 3;
  }

  /* Brand Box */
  #shopify-section-{{ section.id }} .slide__brand-box {
    position: absolute;
    bottom: 14%;
    right: auto;
    width: 100%;
    left: auto;
    padding: 0 8rem;
    display: flex;
    justify-content: flex-end;
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .slide__brand-link {
    display: flex;
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.4);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    border-radius: 12px;
    max-width: 220px;
    width: 220px;
    padding: 20px;
    gap: 5px;
    position: relative;
    text-decoration: none;
  }

  @keyframes pulse {
    0% { transform: scale(1.05); }
    50% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }

  #shopify-section-{{ section.id }} .slide__brand-link:hover {
    animation: pulse 1.5s infinite;
  }

  #shopify-section-{{ section.id }} .slide__brand-logo {
    align-self: center;
  }

  #shopify-section-{{ section.id }} .slide__brand-arrow {
    position: absolute;
    right: 10px;
    top: 8px;
  }

  /* Content Box */
  #shopify-section-{{ section.id }} .slide__box {
    padding: 4rem;
    max-width: 600px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .slide__box.text-left { text-align: left; }
  #shopify-section-{{ section.id }} .slide__box.text-center { text-align: center; }
  #shopify-section-{{ section.id }} .slide__box.text-right { text-align: right; }

  #shopify-section-{{ section.id }} .slide__box--with-background {
    background-color: rgba(var(--color-overlay), var(--color-overlay-opacity));
    border-radius: 12px;
  }

  /* Slide Media */
  #shopify-section-{{ section.id }} .slide__media {
    position: relative;
    width: 100%;
    height: {{ section.settings.image_ratio }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .slide__media::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(var(--color-overlay), var(--color-overlay-opacity));
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .slide__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  /* Content Elements */
  #shopify-section-{{ section.id }} .slide__heading {
    color: rgb(var(--color-foreground));
    margin: 0 0 1rem;
  }

  #shopify-section-{{ section.id }} .slide__subheading {
    color: rgb(var(--color-foreground));
    margin: 0 0 0.5rem;
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .slide__text {
    color: rgb(var(--color-foreground));
    margin: 0 0 1.5rem;
  }

  #shopify-section-{{ section.id }} .slide__button-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .slide__box.text-center .slide__button-group {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .slide__box.text-right .slide__button-group {
    justify-content: flex-end;
  }

  /* Navigation Arrows */
  #shopify-section-{{ section.id }} .slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  #shopify-section-{{ section.id }} .slider-nav:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.1);
  }

  #shopify-section-{{ section.id }} .slider-nav--prev {
    left: 20px;
  }

  #shopify-section-{{ section.id }} .slider-nav--next {
    right: 20px;
  }

  #shopify-section-{{ section.id }} .slider-nav svg {
    width: 24px;
    height: 24px;
  }

  /* Pagination Dots */
  #shopify-section-{{ section.id }} .slider-pagination {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .slider-dot {
    width: 5rem;
    height: 0.3rem;
    cursor: pointer;
    background-color:#9bacbe;
    transition: all 0.3s ease;
    padding: 0;
        border: none;
  }

  #shopify-section-{{ section.id }} .slider-dot.active,
  #shopify-section-{{ section.id }} .slider-dot:hover {
    background-color: #17416f;

  }

  /* Autoplay Progress Bar */
  #shopify-section-{{ section.id }} .slider-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.8);
    z-index: 10;
    width: 0;
  }

  #shopify-section-{{ section.id }} .slider-progress.animating {
    animation: progress var(--autoplay-speed) linear forwards;
  }
    #shopify-section-{{ section.id }} .slide__brand-box .slide__brand-logo{
      max-width:106px;
      max-height:50px;
      object-fit: contain;
    }
    #shopify-section-{{ section.id }} .slide__brand-box .slide__brand-product{
          max-width: inherit;

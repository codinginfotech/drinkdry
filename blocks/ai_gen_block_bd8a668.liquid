{% style %}
  .ai-pdf-library-{{ ai_gen_id }} {
    display: block;
    width: min({{ block.settings.desktop_width_percent }}%, 100%);
    max-width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    --ai-pdf-desktop-height: {{ block.settings.viewer_height }}px;
    --ai-pdf-mobile-height: {{ block.settings.mobile_viewer_height }}px;
    --ai-pdf-available-height: calc(100dvh - 220px);
    --ai-pdf-adaptive-height: clamp(420px, var(--ai-pdf-available-height), var(--ai-pdf-desktop-height));
  }

  .ai-pdf-library-{{ ai_gen_id }} *,
  .ai-pdf-library-{{ ai_gen_id }} *::before,
  .ai-pdf-library-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }

  @supports not (height: 100dvh) {
    .ai-pdf-library-{{ ai_gen_id }} {
      --ai-pdf-available-height: calc(100vh - 220px);
    }
  }

  .ai-pdf-library-shell-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(200px, min({{ block.settings.sidebar_width }}px, 32vw)) minmax(0, 1fr);
    width: 100%;
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-pdf-library-sidebar-{{ ai_gen_id }} {
    min-width: 0;
    min-height: 0;
    background: {{ block.settings.sidebar_background_color }};
    border-right: 1px solid {{ block.settings.border_color }};
    overflow: hidden;
  }

  .ai-pdf-library-sidebar-header-{{ ai_gen_id }} {
    padding: 18px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-pdf-library-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(16px, 1.8vw, {{ block.settings.heading_size }}px);
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-pdf-library-count-{{ ai_gen_id }} {
    display: block;
    margin-top: 6px;
    color: {{ block.settings.muted_text_color }};
    font-size: 13px;
  }

  .ai-pdf-library-list-{{ ai_gen_id }} {
    padding: 12px;
    max-height: calc(var(--ai-pdf-adaptive-height) + 69px);
    overflow-y: auto;
    overflow-x: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .ai-pdf-library-item-{{ ai_gen_id }} {
    width: 100%;
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    color: {{ block.settings.text_color }};
    text-align: left;
    padding: 8px;
    border-radius: {{ block.settings.item_border_radius }}px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .ai-pdf-library-item-{{ ai_gen_id }}:hover {
    background: {{ block.settings.item_hover_color }};
    transform: translateY(-1px);
  }

  .ai-pdf-library-item-{{ ai_gen_id }}.is-active {
    background: {{ block.settings.item_active_color }};
    border-color: {{ block.settings.button_color }};
  }

  .ai-pdf-library-thumbnail-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    border-radius: max(0px, calc({{ block.settings.item_border_radius }}px - 2px));
    background: #e5e7eb;
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-pdf-library-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-pdf-library-thumbnail-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.button_color }};
    background: linear-gradient(135deg, #ffffff 0%, #eef4fb 100%);
  }

  .ai-pdf-library-icon-{{ ai_gen_id }} {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    color: currentColor;
  }

  .ai-pdf-library-item-title-{{ ai_gen_id }} {
    display: -webkit-box;
    font-size: 14px;
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-pdf-library-item-{{ ai_gen_id }}.is-active .ai-pdf-library-item-title-{{ ai_gen_id }} {
    font-weight: 700;
    color: {{ block.settings.heading_color }};
  }

  .ai-pdf-library-main-{{ ai_gen_id }} {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .ai-pdf-library-toolbar-{{ ai_gen_id }} {
    min-height: 68px;
    padding: 14px 16px;
    background: {{ block.settings.header_background_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
  }

  .ai-pdf-library-current-title-{{ ai_gen_id }} {
    min-width: 0;
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(16px, 1.6vw, {{ block.settings.title_size }}px);
    line-height: 1.3;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-pdf-library-actions-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .ai-pdf-library-action-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    min-width: 0;
    padding: 9px 14px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: 14px;
    line-height: 1.2;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
  }

  .ai-pdf-library-action-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
  }

  .ai-pdf-library-action-secondary-{{ ai_gen_id }} {
    background: transparent;
    color: {{ block.settings.button_color }};
  }

  .ai-pdf-library-action-secondary-{{ ai_gen_id }}:hover {
    background: {{ block.settings.item_hover_color }};
    color: {{ block.settings.button_hover_color }};
  }

  .ai-pdf-library-action-{{ ai_gen_id }} svg {
    width: 17px;
    height: 17px;
  }

  .ai-pdf-library-viewer-wrap-{{ ai_gen_id }} {
    width: 100%;
    height: var(--ai-pdf-adaptive-height);
    min-height: 0;
    background: #f4f4f4;
    overflow: hidden;
  }


  .ai-pdf-library-frame-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 0;
    border: 0;
    display: block;
    background: #ffffff;
  }

  .ai-pdf-library-empty-{{ ai_gen_id }} {
    min-height: var(--ai-pdf-adaptive-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    text-align: center;
    color: {{ block.settings.muted_text_color }};
    background: #fafafa;
  }

  @media screen and (max-width: 900px) {
    .ai-pdf-library-{{ ai_gen_id }} {
      width: 100%;
      --ai-pdf-available-height: 70dvh;
      --ai-pdf-adaptive-height: clamp(360px, var(--ai-pdf-available-height), var(--ai-pdf-mobile-height));
    }

    @supports not (height: 100dvh) {
      .ai-pdf-library-{{ ai_gen_id }} {
        --ai-pdf-available-height: 70vh;
      }
    }

    .ai-pdf-library-shell-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-pdf-library-sidebar-{{ ai_gen_id }} {
      border-right: 0;
      border-bottom: 1px solid {{ block.settings.border_color }};
      overflow: visible;
    }

    .ai-pdf-library-sidebar-header-{{ ai_gen_id }} {
      padding: 14px 16px;
    }

    .ai-pdf-library-list-{{ ai_gen_id }} {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      overflow-y: hidden;
      max-height: none;
      padding: 10px 12px 14px;
      scroll-snap-type: x proximity;
    }

    .ai-pdf-library-item-{{ ai_gen_id }} {
      width: clamp(140px, 42vw, 220px);
      min-width: clamp(140px, 42vw, 220px);
      max-width: 220px;
      flex: 0 0 auto;
      scroll-snap-align: start;
    }

    .ai-pdf-library-thumbnail-{{ ai_gen_id }} {
      aspect-ratio: 4 / 3;
    }

    .ai-pdf-library-toolbar-{{ ai_gen_id }} {
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
      padding: 12px;
    }

    .ai-pdf-library-current-title-{{ ai_gen_id }} {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .ai-pdf-library-actions-{{ ai_gen_id }} {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    .ai-pdf-library-action-{{ ai_gen_id }} {
      width: 100%;
      min-height: 44px;
      padding: 10px 12px;
      white-space: normal;
    }
  }

  @media screen and (max-width: 600px) {
    .ai-pdf-library-{{ ai_gen_id }} {
      --ai-pdf-available-height: 72dvh;
      --ai-pdf-adaptive-height: clamp(340px, var(--ai-pdf-available-height), var(--ai-pdf-mobile-height));
    }

    @supports not (height: 100dvh) {
      .ai-pdf-library-{{ ai_gen_id }} {
        --ai-pdf-available-height: 72vh;
      }
    }

    .ai-pdf-library-shell-{{ ai_gen_id }} {
      border-radius: min({{ block.settings.border_radius }}px, 14px);
    }

    .ai-pdf-library-item-{{ ai_gen_id }} {
      width: clamp(132px, 46vw, 180px);
      min-width: clamp(132px, 46vw, 180px);
    }

    .ai-pdf-library-actions-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 380px) {
    .ai-pdf-library-{{ ai_gen_id }} {
      --ai-pdf-available-height: 70dvh;
      --ai-pdf-adaptive-height: clamp(320px, var(--ai-pdf-available-height), var(--ai-pdf-mobile-height));
    }

    .ai-pdf-library-list-{{ ai_gen_id }} {
      padding-inline: 8px;
    }

    .ai-pdf-library-item-{{ ai_gen_id }} {
      width: 128px;
      min-width: 128px;
    }
  }

  @media screen and (max-width: 900px) and (orientation: landscape) and (max-height: 600px) {
    .ai-pdf-library-{{ ai_gen_id }} {
      --ai-pdf-available-height: 76dvh;
      --ai-pdf-adaptive-height: clamp(280px, var(--ai-pdf-available-height), var(--ai-pdf-mobile-height));
    }

    .ai-pdf-library-sidebar-header-{{ ai_gen_id }} {
      display: none;
    }

    .ai-pdf-library-thumbnail-{{ ai_gen_id }} {
      aspect-ratio: 16 / 10;
    }
  }
{% endstyle %}

<pdf-library-viewer-{{ ai_gen_id }}
  class="ai-pdf-library-{{ ai_gen_id }}"
  data-view-mode="{{ block.settings.view_mode }}"
  data-show-toolbar="{{ block.settings.show_toolbar }}"
  data-initial-pdf-url="{{ first_pdf_url | escape }}"
  data-initial-pdf-title="{{ first_pdf_title | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-pdf-library-shell-{{ ai_gen_id }}">
    <aside class="ai-pdf-library-sidebar-{{ ai_gen_id }}">
      <div class="ai-pdf-library-sidebar-header-{{ ai_gen_id }}">
        <h3 class="ai-pdf-library-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h3>

        <span class="ai-pdf-library-count-{{ ai_gen_id }}">
          {{ pdf_count }} document{% unless pdf_count == 1 %}s{% endunless %}
        </span>
      </div>

      <div class="ai-pdf-library-list-{{ ai_gen_id }}">
        {% if block.settings.pdf_1_url != blank %}
          {% assign pdf_title = block.settings.pdf_1_title | default: 'Document 1' %}
          {% assign pdf_thumbnail = block.settings.pdf_1_thumbnail %}
          <button type="button" class="ai-pdf-library-item-{{ ai_gen_id }} {% if first_pdf_key == '1' %}is-active{% endif %}" data-pdf-trigger data-pdf-url="{{ block.settings.pdf_1_url | escape }}" data-pdf-title="{{ pdf_title | escape }}" aria-label="View {{ pdf_title | escape }}">
            <span class="ai-pdf-library-thumbnail-{{ ai_gen_id }}">
              {% if pdf_thumbnail != blank %}
                <img src="{{ pdf_thumbnail | image_url: width: 520 }}" alt="{{ pdf_title | escape }} thumbnail" loading="lazy" width="520" height="360">
              {% else %}
                <span class="ai-pdf-library-thumbnail-placeholder-{{ ai_gen_id }}">
                  <svg class="ai-pdf-library-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"/><path d="M14 2v5h5"/><path d="M9 13h6"/><path d="M9 17h6"/></svg>
                </span>
              {% endif %}
            </span>
            <span class="ai-pdf-library-item-title-{{ ai_gen_id }}">{{ pdf_title }}</span>
          </button>
        {% endif %}

        {% if block.settings.pdf_2_url != blank %}
          {% assign pdf_title = block.settings.pdf_2_title | default: 'Document 2' %}
          {% assign pdf_thumbnail = block.settings.pdf_2_thumbnail %}

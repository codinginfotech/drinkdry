<script>
  (function() {
    class PdfLibraryViewer{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.triggers = this.querySelectorAll('[data-pdf-trigger]');
        this.frame = this.querySelector('[data-pdf-frame]');
        this.title = this.querySelector('[data-pdf-current-title]');
        this.viewLink = this.querySelector('[data-pdf-view-link]');

        this.viewMode = this.dataset.viewMode || 'FitH';
        this.showToolbar = this.dataset.showToolbar || '1';
        this.mobileQuery = window.matchMedia('(max-width: 900px)');
        this.currentPdfUrl = this.dataset.initialPdfUrl || '';
        this.currentPdfTitle = this.dataset.initialPdfTitle || 'PDF document';
        this.resizeTimer = null;

        if (this.viewLink) {
          this.viewLink.addEventListener('click', (event) => {
            const activeTrigger = this.querySelector('[data-pdf-trigger].is-active');
            const selectedUrl = activeTrigger ? activeTrigger.dataset.pdfUrl : this.currentPdfUrl;
            const cleanUrl = this.getCleanUrl(selectedUrl || this.currentPdfUrl);

            if (!cleanUrl) return;

            event.preventDefault();
            this.viewLink.href = cleanUrl;
            window.open(cleanUrl, '_blank', 'noopener');
          });
        }

        this.updateAvailableHeight();

        this.triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const pdfUrl = trigger.dataset.pdfUrl;
            const pdfTitle = trigger.dataset.pdfTitle || 'PDF document';

            this.triggers.forEach((item) => item.classList.remove('is-active'));
            trigger.classList.add('is-active');

            this.loadPdf(pdfUrl, pdfTitle);
          });
        });

        this.handleResponsiveChange = () => {
          this.updateAvailableHeight();

          if (this.currentPdfUrl) {
            this.loadPdf(this.currentPdfUrl, this.currentPdfTitle, true);
          }
        };

        this.handleResize = () => {
          window.clearTimeout(this.resizeTimer);
          this.resizeTimer = window.setTimeout(() => {
            this.updateAvailableHeight();
          }, 120);
        };

        if (this.mobileQuery.addEventListener) {
          this.mobileQuery.addEventListener('change', this.handleResponsiveChange);
        } else if (this.mobileQuery.addListener) {
          this.mobileQuery.addListener(this.handleResponsiveChange);
        }

        window.addEventListener('resize', this.handleResize, { passive: true });
        window.addEventListener('orientationchange', this.handleResponsiveChange, { passive: true });

        if (this.currentPdfUrl && this.frame) {
          this.loadPdf(this.currentPdfUrl, this.currentPdfTitle, true);
        }
      }

      disconnectedCallback() {
        window.clearTimeout(this.resizeTimer);

        if (this.mobileQuery) {
          if (this.mobileQuery.removeEventListener) {
            this.mobileQuery.removeEventListener('change', this.handleResponsiveChange);
          } else if (this.mobileQuery.removeListener) {
            this.mobileQuery.removeListener(this.handleResponsiveChange);
          }
        }

        window.removeEventListener('resize', this.handleResize);
        window.removeEventListener('orientationchange', this.handleResponsiveChange);
      }

      updateAvailableHeight() {
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
        const rect = this.getBoundingClientRect();
        const safeTop = Math.max(rect.top, 0);
        const bottomGap = window.innerWidth <= 600 ? 12 : 24;
        const minimum = window.innerWidth <= 380 ? 300 : window.innerWidth <= 900 ? 320 : 420;
        const availableHeight = Math.max(minimum, viewportHeight - safeTop - bottomGap);

        this.style.setProperty('--ai-pdf-available-height', `${Math.round(availableHeight)}px`);
      }

      getCleanUrl(pdfUrl) {
        return String(pdfUrl || '').split('#')[0];
      }

      buildViewerUrl(pdfUrl) {
        const cleanUrl = this.getCleanUrl(pdfUrl);
        const isMobile = this.mobileQuery ? this.mobileQuery.matches : window.innerWidth <= 900;
        const viewMode = isMobile ? 'FitH' : this.viewMode;
        const toolbar = this.showToolbar;
        const zoom = 'page-width';
        const fragment = [
          `view=${encodeURIComponent(viewMode)}`,
          `zoom=${encodeURIComponent(zoom)}`,
          `toolbar=${encodeURIComponent(toolbar)}`,
          'navpanes=0',
          'scrollbar=1'
        ].join('&');

        return `${cleanUrl}#${fragment}`;
      }

      loadPdf(pdfUrl, pdfTitle, forceReload = false) {
        const cleanUrl = this.getCleanUrl(pdfUrl);
        const viewerUrl = this.buildViewerUrl(cleanUrl);

        this.currentPdfUrl = cleanUrl;
        this.currentPdfTitle = pdfTitle;

        if (this.frame && (forceReload || this.frame.src !== viewerUrl)) {
          this.frame.src = viewerUrl;
          this.frame.title = pdfTitle;
        }

        if (this.title) {
          this.title.textContent = pdfTitle;
        }

        if (this.viewLink) {
          this.viewLink.href = cleanUrl;
          this.viewLink.setAttribute('href', cleanUrl);
          this.viewLink.dataset.currentPdfUrl = cleanUrl;
        }
      }
    }

    if (!customElements.get('pdf-library-viewer-{{ ai_gen_id }}')) {
      customElements.define('pdf-library-viewer-{{ ai_gen_id }}', PdfLibraryViewer{{ ai_gen_id }});
    }
  })();
</script>

